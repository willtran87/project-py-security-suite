{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:project-py-security-suite:schema:benchmark-scorecard:1.0", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "analysis", "source_sha256", "benchmarks_enabled", "benchmarks_executed", "benchmarks_passed", "complete", "passed", "benchmarks", "benchmark_scope", "aggregate_metrics", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "1.0"}, "analysis": {"const": "industry-benchmark-scorecard"}, "source_sha256": {"type": "string", "pattern": "^([0-9a-f]{64})?$"}, "benchmarks_enabled": {"type": "integer", "minimum": 0}, "benchmarks_executed": {"type": "integer", "minimum": 0}, "benchmarks_passed": {"type": "integer", "minimum": 0}, "complete": {"type": "boolean"}, "passed": {"type": "boolean"},
    "benchmarks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["benchmark_id", "benchmark_protocol", "corpus_sha256", "evidence_artifact", "evidence_source", "evidence_present", "evidence_valid", "reproducibility_complete", "passed", "metrics", "protocol_metrics", "gaps"], "properties": {"benchmark_id": {"type": "string"}, "benchmark_protocol": {"enum": ["classification", "temporal-calibration", "verification-competition", "test-generation", "fuzzing-statistical", "stochastic-adversarial", "assessor-agreement", "conformance", "detection-evaluation"]}, "corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "evidence_artifact": {"type": "string"}, "evidence_source": {"enum": ["governed-artifact", "sealed-snapshot", "missing", "invalid"]}, "evidence_present": {"type": "boolean"}, "evidence_valid": {"type": "boolean"}, "reproducibility_complete": {"type": "boolean"}, "passed": {"type": "boolean"}, "metrics": {"$ref": "#/$defs/metrics"}, "protocol_metrics": {"type": "object", "additionalProperties": {"type": ["number", "integer", "string", "boolean", "null"]}}, "gaps": {"type": "array", "items": {"type": "string"}}}}},
    "benchmark_scope": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["benchmark_id", "benchmark_protocol", "corpus_sha256"], "properties": {"benchmark_id": {"type": "string"}, "benchmark_protocol": {"type": "string"}, "corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "aggregate_metrics": {"$ref": "#/$defs/metrics"}, "claim_boundary": {"type": "string"}
  },
  "$defs": {"metric": {"type": ["number", "null"], "minimum": -1, "maximum": 1}, "metrics": {"type": "object", "additionalProperties": false, "required": ["precision", "recall", "specificity", "f1", "mcc", "balanced_accuracy", "false_positive_rate", "youden_j"], "properties": {"precision": {"$ref": "#/$defs/metric"}, "recall": {"$ref": "#/$defs/metric"}, "specificity": {"$ref": "#/$defs/metric"}, "f1": {"$ref": "#/$defs/metric"}, "mcc": {"$ref": "#/$defs/metric"}, "balanced_accuracy": {"$ref": "#/$defs/metric"}, "false_positive_rate": {"$ref": "#/$defs/metric"}, "youden_j": {"$ref": "#/$defs/metric"}}}}
}
