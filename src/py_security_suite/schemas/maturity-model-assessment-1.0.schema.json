{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:project-py-security-suite:schema:maturity-model-assessment:1.0", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "analysis", "applicable", "required_models", "models_assessed", "models_complete", "complete", "models", "gaps", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "1.0"}, "analysis": {"const": "governed-maturity-model-assessment"}, "applicable": {"type": "boolean"}, "required_models": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "models_assessed": {"type": "integer", "minimum": 0}, "models_complete": {"type": "integer", "minimum": 0}, "complete": {"type": "boolean"},
    "models": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "version", "scope_sha256", "evidence_sha256", "method_sha256", "report_sha256", "assessor", "replay_protected", "independent_reviewers", "domains", "complete", "gaps"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "scope_sha256": {"$ref": "#/$defs/digest"}, "evidence_sha256": {"$ref": "#/$defs/digest"}, "method_sha256": {"$ref": "#/$defs/digest"}, "report_sha256": {"$ref": "#/$defs/digest"}, "assessor": {"$ref": "#/$defs/assessor"}, "replay_protected": {"type": "boolean"}, "independent_reviewers": {"type": "integer", "minimum": 0}, "domains": {"type": "array", "items": {"type": "string"}}, "complete": {"type": "boolean"}, "gaps": {"type": "array", "items": {"type": "string"}}}}},
    "gaps": {"type": "array", "items": {"type": "string"}}, "claim_boundary": {"type": "string", "minLength": 1}
  }, "$defs": {"digest": {"type": "string", "pattern": "^([0-9a-f]{64})?$"}, "assessor": {"type": "object", "additionalProperties": false, "required": ["identity", "independent", "competency_sha256"], "properties": {"identity": {"type": "string"}, "independent": {"type": "boolean"}, "competency_sha256": {"$ref": "#/$defs/digest"}}}}
}
