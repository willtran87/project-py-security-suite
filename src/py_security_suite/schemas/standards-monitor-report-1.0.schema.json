{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:standards-monitor-report:1.0",
  "type": "object",
  "required": ["schema_version", "analysis", "manifest_sha256", "sources_assessed", "sources_changed", "sources_unavailable", "decision", "sources", "review_artifact", "report_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "analysis": {"const": "standards-publisher-lifecycle-monitor"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sources_assessed": {"type": "integer", "minimum": 1},
    "sources_changed": {"type": "integer", "minimum": 0},
    "sources_unavailable": {"type": "integer", "minimum": 0},
    "decision": {"enum": ["current", "review-required", "incomplete"]},
    "sources": {"type": "array", "minItems": 1},
    "review_artifact": {"type": "object", "required": ["required_source_ids", "approval_status", "required_approvals"]},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {
      "type": "object",
      "required": ["algorithm", "key_id", "signature", "signed_payload_sha256"],
      "properties": {"algorithm": {"const": "Ed25519"}}
    }
  }
}
