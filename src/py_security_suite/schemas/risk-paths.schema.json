{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:risk-paths:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "schema_id", "authoritative", "purpose", "summary",
    "evidence_availability", "routes", "convergence_hotspots",
    "validation_campaigns", "validation_test_hotspots", "owner_work_queues", "unrouted_targets", "truncation",
    "interpretation_limits", "references"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "schema_id": {"const": "urn:project-py-security-suite:risk-paths:1.0"},
    "authoritative": {"const": false},
    "purpose": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_available", "reachability_available", "entry_points",
        "candidate_targets", "targets_analyzed", "finding_targets", "sink_surface_targets",
        "dependency_advisory_import_targets",
        "routed_targets", "unrouted_targets", "routed_findings",
        "routed_sink_surfaces", "routed_dependency_advisory_imports",
        "unrouted_dependency_advisory_imports", "distinct_routed_dependency_advisories",
        "known_exploited_dependency_routes", "high_epss_dependency_routes",
        "dependency_routes_with_fixed_versions", "dependency_routes_with_validation_gaps",
        "dependency_routes_at_changed_importers",
        "dependency_routes_with_uncovered_changed_lines",
        "runtime_observed_routes",
        "coverage_gap_routes", "validation_gap_routes",
        "validation_assessed_routes", "validation_unassessed_routes", "owned_routes",
        "convergence_hotspots", "shared_control_points",
        "routes_in_convergence_hotspots", "owner_work_queues",
        "validation_campaigns", "campaigns_with_selected_tests",
        "shared_validation_test_hotspots", "campaigns_using_shared_tests",
        "routes_using_shared_tests", "single_test_dependency_campaigns",
        "campaigns_with_failing_tests", "campaigns_with_coverage_gaps",
        "campaigns_with_changed_controls", "campaigns_with_uncovered_changed_lines",
        "campaigns_with_runtime_observation_gaps",
        "campaigns_aligned_current_evidence", "campaigns_requiring_evidence",
        "unique_campaign_test_files", "campaigns_by_review_tier",
        "campaigns_revision_aligned", "campaigns_revision_mismatched",
        "campaigns_revision_unbound", "campaigns_with_source_bound_control_points",
        "selected_test_source_bindings",
        "routes_by_priority"
      ],
      "properties": {
        "graph_available": {"type": "boolean"},
        "reachability_available": {"type": "boolean"},
        "entry_points": {"$ref": "#/$defs/count"},
        "candidate_targets": {"$ref": "#/$defs/count"},
        "targets_analyzed": {"$ref": "#/$defs/count"},
        "finding_targets": {"$ref": "#/$defs/count"},
        "sink_surface_targets": {"$ref": "#/$defs/count"},
        "dependency_advisory_import_targets": {"$ref": "#/$defs/count"},
        "routed_targets": {"$ref": "#/$defs/count"},
        "unrouted_targets": {"$ref": "#/$defs/count"},
        "routed_findings": {"$ref": "#/$defs/count"},
        "routed_sink_surfaces": {"$ref": "#/$defs/count"},
        "routed_dependency_advisory_imports": {"$ref": "#/$defs/count"},
        "unrouted_dependency_advisory_imports": {"$ref": "#/$defs/count"},
        "distinct_routed_dependency_advisories": {"$ref": "#/$defs/count"},
        "known_exploited_dependency_routes": {"$ref": "#/$defs/count"},
        "high_epss_dependency_routes": {"$ref": "#/$defs/count"},
        "dependency_routes_with_fixed_versions": {"$ref": "#/$defs/count"},
        "dependency_routes_with_validation_gaps": {"$ref": "#/$defs/count"},
        "dependency_routes_at_changed_importers": {"$ref": "#/$defs/count"},
        "dependency_routes_with_uncovered_changed_lines": {"$ref": "#/$defs/count"},
        "runtime_observed_routes": {"$ref": "#/$defs/count"},
        "coverage_gap_routes": {"$ref": "#/$defs/count"},
        "validation_gap_routes": {"$ref": "#/$defs/count"},
        "validation_assessed_routes": {"$ref": "#/$defs/count"},
        "validation_unassessed_routes": {"$ref": "#/$defs/count"},
        "owned_routes": {"$ref": "#/$defs/count"},
        "convergence_hotspots": {"$ref": "#/$defs/count"},
        "shared_control_points": {"$ref": "#/$defs/count"},
        "routes_in_convergence_hotspots": {"$ref": "#/$defs/count"},
        "owner_work_queues": {"$ref": "#/$defs/count"},
        "validation_campaigns": {"$ref": "#/$defs/count"},
        "shared_validation_test_hotspots": {"$ref": "#/$defs/count"},
        "campaigns_using_shared_tests": {"$ref": "#/$defs/count"},
        "routes_using_shared_tests": {"$ref": "#/$defs/count"},
        "single_test_dependency_campaigns": {"$ref": "#/$defs/count"},
        "campaigns_with_selected_tests": {"$ref": "#/$defs/count"},
        "campaigns_with_failing_tests": {"$ref": "#/$defs/count"},
        "campaigns_with_coverage_gaps": {"$ref": "#/$defs/count"},
        "campaigns_with_changed_controls": {"$ref": "#/$defs/count"},
        "campaigns_with_uncovered_changed_lines": {"$ref": "#/$defs/count"},
        "campaigns_with_runtime_observation_gaps": {"$ref": "#/$defs/count"},
        "campaigns_aligned_current_evidence": {"$ref": "#/$defs/count"},
        "campaigns_requiring_evidence": {"$ref": "#/$defs/count"},
        "unique_campaign_test_files": {"$ref": "#/$defs/count"},
        "campaigns_by_review_tier": {"$ref": "#/$defs/reviewTierCounts"},
        "campaigns_revision_aligned": {"$ref": "#/$defs/count"},
        "campaigns_revision_mismatched": {"$ref": "#/$defs/count"},
        "campaigns_revision_unbound": {"$ref": "#/$defs/count"},
        "campaigns_with_source_bound_control_points": {"$ref": "#/$defs/count"},
        "selected_test_source_bindings": {"$ref": "#/$defs/count"},
        "routes_by_priority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["P0", "P1", "P2", "P3", "P4"],
          "properties": {
            "P0": {"$ref": "#/$defs/count"},
            "P1": {"$ref": "#/$defs/count"},
            "P2": {"$ref": "#/$defs/count"},
            "P3": {"$ref": "#/$defs/count"},
            "P4": {"$ref": "#/$defs/count"}
          }
        }
      }
    },
    "evidence_availability": {
      "type": "object",
      "additionalProperties": {"type": "boolean"},
      "minProperties": 1
    },
    "routes": {
      "type": "array",
      "maxItems": 250,
      "items": {"$ref": "#/$defs/route"}
    },
    "convergence_hotspots": {
      "type": "array",
      "maxItems": 50,
      "items": {"$ref": "#/$defs/convergenceHotspot"}
    },
    "validation_campaigns": {
      "type": "array",
      "maxItems": 50,
      "items": {"$ref": "#/$defs/validationCampaign"}
    },
    "validation_test_hotspots": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/validationTestHotspot"}
    },
    "owner_work_queues": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/ownerQueue"}
    },
    "unrouted_targets": {
      "type": "array",
      "maxItems": 250,
      "items": {"$ref": "#/$defs/unrouted"}
    },
    "truncation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_files_omitted", "entry_points_omitted", "targets_omitted",
        "dependency_advisory_import_targets_omitted",
        "routes_omitted", "unrouted_targets_omitted",
        "convergence_hotspots_omitted", "validation_test_hotspots_omitted",
        "owner_work_queues_omitted"
      ],
      "properties": {
        "graph_files_omitted": {"$ref": "#/$defs/count"},
        "entry_points_omitted": {"$ref": "#/$defs/count"},
        "targets_omitted": {"$ref": "#/$defs/count"},
        "dependency_advisory_import_targets_omitted": {"$ref": "#/$defs/count"},
        "routes_omitted": {"$ref": "#/$defs/count"},
        "unrouted_targets_omitted": {"$ref": "#/$defs/count"},
        "convergence_hotspots_omitted": {"$ref": "#/$defs/count"},
        "validation_test_hotspots_omitted": {"$ref": "#/$defs/count"},
        "owner_work_queues_omitted": {"$ref": "#/$defs/count"}
      }
    },
    "interpretation_limits": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "references": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "strings": {
      "type": "array", "items": {"type": "string", "minLength": 1}
    },
    "nullableString": {"type": ["string", "null"]},
    "nullableDigest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "entryPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "declared_as", "path", "line"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "declared_as": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "line": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "id", "finding_id", "path", "line", "label", "domain",
        "area", "severity", "tools", "classifications"
      ],
      "properties": {
        "kind": {"enum": ["finding", "sink-surface", "dependency-advisory-import"]},
        "id": {"type": "string", "minLength": 1},
        "finding_id": {"$ref": "#/$defs/nullableString"},
        "path": {"type": "string", "minLength": 1},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "label": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "area": {"type": "string", "minLength": 1},
        "severity": {"$ref": "#/$defs/nullableString"},
        "tools": {"$ref": "#/$defs/strings"},
        "classifications": {"$ref": "#/$defs/strings"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "relation"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "relation": {"type": "string", "minLength": 1}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reachability_states", "observations"],
      "properties": {
        "reachability_states": {"$ref": "#/$defs/strings"},
        "observations": {"$ref": "#/$defs/strings"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed_line", "line_covered", "coverage_percent",
        "mapped_test_files", "focused_test_status", "coverage_alignment",
        "gap_reasons", "action", "assessment_status", "assessment_reasons",
        "evidence_available"
      ],
      "properties": {
        "changed_line": {"type": ["boolean", "null"]},
        "line_covered": {"type": ["boolean", "null"]},
        "coverage_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "mapped_test_files": {"$ref": "#/$defs/strings"},
        "focused_test_status": {"$ref": "#/$defs/nullableString"},
        "coverage_alignment": {"$ref": "#/$defs/nullableString"},
        "gap_reasons": {"$ref": "#/$defs/strings"},
        "action": {"$ref": "#/$defs/nullableString"},
        "assessment_status": {"enum": ["aligned", "gap", "partial", "not-assessed"]},
        "assessment_reasons": {"$ref": "#/$defs/strings"},
        "evidence_available": {
          "type": "object",
          "additionalProperties": false,
          "required": ["change_scope", "coverage", "test_execution"],
          "properties": {
            "change_scope": {"type": "boolean"},
            "coverage": {"type": "boolean"},
            "test_execution": {"type": "boolean"}
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id", "priority", "entry_point", "target", "hop_count",
        "files", "edges", "owners", "runtime_context", "validation",
        "correlations", "convergence_hotspot_ids", "validation_campaign_ids",
        "validation_test_hotspot_ids", "recommended_action",
        "evidence_artifacts"
      ],
      "properties": {
        "route_id": {"type": "string", "pattern": "^route-[0-9a-f]{16}$"},
        "priority": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
        "entry_point": {"$ref": "#/$defs/entryPoint"},
        "target": {"$ref": "#/$defs/target"},
        "hop_count": {"type": "integer", "minimum": 0, "maximum": 8},
        "files": {"type": "array", "minItems": 1, "maxItems": 9, "items": {"type": "string", "minLength": 1}},
        "edges": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/edge"}},
        "owners": {"$ref": "#/$defs/strings"},
        "runtime_context": {"$ref": "#/$defs/runtime"},
        "validation": {"$ref": "#/$defs/validation"},
        "correlations": {"type": "object"},
        "validation_test_hotspot_ids": {"$ref": "#/$defs/strings"},
        "convergence_hotspot_ids": {"$ref": "#/$defs/strings"},
        "validation_campaign_ids": {"$ref": "#/$defs/strings"},
        "recommended_action": {"type": "string", "minLength": 1},
        "evidence_artifacts": {"$ref": "#/$defs/strings"}
      }
    },
    "validationCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aligned", "gap", "partial", "not-assessed"],
      "properties": {
        "aligned": {"$ref": "#/$defs/count"},
        "gap": {"$ref": "#/$defs/count"},
        "partial": {"$ref": "#/$defs/count"},
        "not-assessed": {"$ref": "#/$defs/count"}
      }
    },
    "priorityCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["P0", "P1", "P2", "P3", "P4"],
      "properties": {
        "P0": {"$ref": "#/$defs/count"},
        "P1": {"$ref": "#/$defs/count"},
        "P2": {"$ref": "#/$defs/count"},
        "P3": {"$ref": "#/$defs/count"},
        "P4": {"$ref": "#/$defs/count"}
      }
    },
    "reviewTierCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "high", "medium", "low"],
      "properties": {
        "critical": {"$ref": "#/$defs/count"},
        "high": {"$ref": "#/$defs/count"},
        "medium": {"$ref": "#/$defs/count"},
        "low": {"$ref": "#/$defs/count"}
      }
    },
    "convergenceHotspot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hotspot_id", "path", "kind", "priority", "route_ids", "target_ids",
        "finding_ids", "entry_point_ids", "tools", "target_domains",
        "security_target_count", "owners",
        "validation_statuses", "mapped_test_files", "evidence_artifacts",
        "validation_campaign_id",
        "recommended_action"
      ],
      "properties": {
        "hotspot_id": {"type": "string", "pattern": "^hotspot-[0-9a-f]{16}$"},
        "path": {"type": "string", "minLength": 1},
        "kind": {"enum": ["target-concentration", "shared-transit", "mixed"]},
        "priority": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
        "route_ids": {"type": "array", "minItems": 2, "items": {"type": "string", "pattern": "^route-[0-9a-f]{16}$"}},
        "target_ids": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "finding_ids": {"$ref": "#/$defs/strings"},
        "entry_point_ids": {"$ref": "#/$defs/strings"},
        "tools": {"$ref": "#/$defs/strings"},
        "target_domains": {"$ref": "#/$defs/strings"},
        "security_target_count": {"$ref": "#/$defs/count"},
        "owners": {"$ref": "#/$defs/strings"},
        "validation_statuses": {"$ref": "#/$defs/validationCounts"},
        "mapped_test_files": {"$ref": "#/$defs/strings"},
        "evidence_artifacts": {"$ref": "#/$defs/strings"},
        "validation_campaign_id": {"type": "string", "pattern": "^campaign-[0-9a-f]{16}$"},
        "recommended_action": {"type": "string", "minLength": 1}
      }
    },
    "testExecutionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "status", "tests", "passed", "failures", "errors", "skipped",
        "sources", "path_attributions"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "status": {"enum": ["failed", "partial", "passed", "skipped", "not-observed"]},
        "tests": {"$ref": "#/$defs/count"},
        "passed": {"$ref": "#/$defs/count"},
        "failures": {"$ref": "#/$defs/count"},
        "errors": {"$ref": "#/$defs/count"},
        "skipped": {"$ref": "#/$defs/count"},
        "sources": {"$ref": "#/$defs/strings"},
        "path_attributions": {"$ref": "#/$defs/strings"}
      }
    },
    "validationCampaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id", "hotspot_id", "path", "priority", "owners", "route_ids",
        "target_ids", "finding_ids", "direct_test_files", "transitive_test_files",
        "route_mapped_test_files", "selected_test_files", "test_selection_confidence",
        "shared_test_hotspot_ids",
        "test_execution_evidence_available", "test_case_inventory_available",
        "test_case_inventory_complete", "test_execution_sources",
        "focused_test_execution", "focused_test_validation_status",
        "unobserved_recommended_test_files", "coverage_status", "coverage_evidence_scope",
        "coverage_attribution", "coverage_percent",
        "missing_line_count", "missing_lines", "test_coverage_alignment",
        "validation_gap_reasons", "control_point_context", "source_snapshot",
        "review_score_model", "review_score", "review_tier", "review_factors",
        "recommended_action", "evidence_artifacts",
        "interpretation"
      ],
      "properties": {
        "campaign_id": {"type": "string", "pattern": "^campaign-[0-9a-f]{16}$"},
        "hotspot_id": {"type": "string", "pattern": "^hotspot-[0-9a-f]{16}$"},
        "path": {"type": "string", "minLength": 1},
        "priority": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
        "owners": {"$ref": "#/$defs/strings"},
        "route_ids": {"$ref": "#/$defs/strings"},
        "target_ids": {"$ref": "#/$defs/strings"},
        "finding_ids": {"$ref": "#/$defs/strings"},
        "direct_test_files": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1}},
        "transitive_test_files": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1}},
        "route_mapped_test_files": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1}},
        "selected_test_files": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1}},
        "shared_test_hotspot_ids": {"type": "array", "maxItems": 100, "items": {"type": "string", "pattern": "^test-hotspot-[0-9a-f]{16}$"}},
        "test_selection_confidence": {"enum": ["high", "medium", "context-only", "not-available"]},
        "test_execution_evidence_available": {"type": "boolean"},
        "test_case_inventory_available": {"type": "boolean"},
        "test_case_inventory_complete": {"type": ["boolean", "null"]},
        "test_execution_sources": {"$ref": "#/$defs/strings"},
        "focused_test_execution": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/testExecutionRecord"}},
        "focused_test_validation_status": {"enum": ["not-selected", "not-available", "failed", "not-observed", "passed", "incomplete"]},
        "unobserved_recommended_test_files": {"$ref": "#/$defs/strings"},
        "coverage_status": {"enum": ["not-available", "gap", "covered"]},
        "coverage_evidence_scope": {"enum": ["aggregate-retained-file", "not-available"]},
        "coverage_attribution": {"const": "not-established"},
        "coverage_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "missing_line_count": {"$ref": "#/$defs/count"},
        "missing_lines": {"type": "array", "maxItems": 100, "items": {"type": "integer", "minimum": 1}},
        "test_coverage_alignment": {"enum": ["not-selected", "test-evidence-not-available", "tests-failing", "tests-not-observed", "tests-incomplete", "coverage-not-available", "coverage-gap", "aligned-current-evidence"]},
        "validation_gap_reasons": {"$ref": "#/$defs/strings"},
        "control_point_context": {"$ref": "#/$defs/controlPointContext"},
        "source_snapshot": {"$ref": "#/$defs/sourceSnapshot"},
        "review_score_model": {"enum": ["shared-control-review-v1", "shared-control-review-v2"]},
        "review_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "review_tier": {"enum": ["critical", "high", "medium", "low"]},
        "review_factors": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/reviewFactor"}},
        "recommended_action": {"type": "string", "minLength": 1},
        "evidence_artifacts": {"$ref": "#/$defs/strings"},
        "interpretation": {"type": "string", "minLength": 1}
      }
    },
    "validationTestHotspot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_hotspot_id", "test_path", "campaign_ids", "control_point_paths",
        "route_ids", "target_ids", "finding_ids", "owners", "highest_priority",
        "highest_review_score", "highest_review_tier", "direct_campaigns",
        "transitive_campaigns", "route_mapped_campaigns",
        "single_test_dependency_campaign_ids", "execution_statuses",
        "observed_case_count", "execution_sources", "source_binding",
        "source_binding_consistent", "recommended_action", "evidence_artifacts",
        "interpretation"
      ],
      "properties": {
        "test_hotspot_id": {"type": "string", "pattern": "^test-hotspot-[0-9a-f]{16}$"},
        "test_path": {"type": "string", "minLength": 1},
        "campaign_ids": {"type": "array", "minItems": 2, "maxItems": 50, "items": {"type": "string", "pattern": "^campaign-[0-9a-f]{16}$"}},
        "control_point_paths": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "string", "minLength": 1}},
        "route_ids": {"$ref": "#/$defs/strings"},
        "target_ids": {"$ref": "#/$defs/strings"},
        "finding_ids": {"$ref": "#/$defs/strings"},
        "owners": {"$ref": "#/$defs/strings"},
        "highest_priority": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
        "highest_review_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "highest_review_tier": {"enum": ["critical", "high", "medium", "low"]},
        "direct_campaigns": {"$ref": "#/$defs/count"},
        "transitive_campaigns": {"$ref": "#/$defs/count"},
        "route_mapped_campaigns": {"$ref": "#/$defs/count"},
        "single_test_dependency_campaign_ids": {"type": "array", "maxItems": 50, "items": {"type": "string", "pattern": "^campaign-[0-9a-f]{16}$"}},
        "execution_statuses": {"type": "array", "items": {"enum": ["failed", "partial", "passed", "skipped", "not-observed"]}},
        "observed_case_count": {"$ref": "#/$defs/count"},
        "execution_sources": {"$ref": "#/$defs/strings"},
        "source_binding": {"anyOf": [{"$ref": "#/$defs/sourceFileBinding"}, {"type": "null"}]},
        "source_binding_consistent": {"type": "boolean"},
        "recommended_action": {"type": "string", "minLength": 1},
        "evidence_artifacts": {"$ref": "#/$defs/strings"},
        "interpretation": {"type": "string", "minLength": 1}
      }
    },
    "sourceFileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "evidenceSourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "declared_source_sha256", "status"],
      "properties": {
        "artifact": {"type": "string", "minLength": 1},
        "declared_source_sha256": {"$ref": "#/$defs/nullableDigest"},
        "status": {"enum": ["aligned", "mismatch", "not-declared", "no-source-inventory"]}
      }
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_inventory_available", "source_sha256", "control_point_binding",
        "selected_test_bindings", "selected_test_files_bound",
        "selected_test_files_missing", "evidence_revision_binding",
        "evidence_revision_binding_reason", "evidence_source_bindings"
      ],
      "properties": {
        "source_inventory_available": {"type": "boolean"},
        "source_sha256": {"$ref": "#/$defs/nullableDigest"},
        "control_point_binding": {"anyOf": [{"$ref": "#/$defs/sourceFileBinding"}, {"type": "null"}]},
        "selected_test_bindings": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/sourceFileBinding"}},
        "selected_test_files_bound": {"type": "integer", "minimum": 0, "maximum": 50},
        "selected_test_files_missing": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1}},
        "evidence_revision_binding": {"enum": ["aligned", "mismatch", "not-established", "not-applicable"]},
        "evidence_revision_binding_reason": {"type": "string", "minLength": 1},
        "evidence_source_bindings": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/evidenceSourceBinding"}}
      }
    },
    "controlPointContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_degree", "maximum_complexity", "maximum_complexity_rank",
        "change_risk_score", "change_priority", "change_classification",
        "changed_lines", "uncovered_changed_lines",
        "changed_line_coverage_percent",
        "reachability_states", "runtime_observations", "evidence_artifacts"
      ],
      "properties": {
        "graph_degree": {"type": ["integer", "null"], "minimum": 0},
        "maximum_complexity": {"type": ["integer", "null"], "minimum": 0},
        "maximum_complexity_rank": {"$ref": "#/$defs/nullableString"},
        "change_risk_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "change_priority": {"enum": ["high", "medium", "low", null]},
        "change_classification": {"$ref": "#/$defs/nullableString"},
        "changed_lines": {"type": ["integer", "null"], "minimum": 0},
        "uncovered_changed_lines": {"type": "array", "maxItems": 100, "items": {"type": "integer", "minimum": 1}},
        "changed_line_coverage_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "reachability_states": {"$ref": "#/$defs/strings"},
        "runtime_observations": {"$ref": "#/$defs/strings"},
        "evidence_artifacts": {"$ref": "#/$defs/strings"}
      }
    },
    "reviewFactor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "points", "evidence", "evidence_artifacts"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "points": {"type": "integer", "minimum": 1, "maximum": 100},
        "evidence": {"type": "string", "minLength": 1},
        "evidence_artifacts": {"$ref": "#/$defs/strings"}
      }
    },
    "ownerQueue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queue_id", "owner", "priority", "routes", "targets", "route_ids",
        "target_ids", "convergence_hotspot_ids", "validation_campaign_ids",
        "validation_test_hotspot_ids", "shared_validation_test_files",
        "campaigns_by_review_tier", "campaigns_revision_mismatched",
        "campaigns_revision_unbound", "campaigns_with_uncovered_changed_lines",
        "campaigns_with_runtime_observation_gaps", "highest_campaign_review_score", "routes_by_priority",
        "validation_statuses", "recommended_action"
      ],
      "properties": {
        "queue_id": {"type": "string", "pattern": "^queue-[0-9a-f]{16}$"},
        "owner": {"type": "string", "minLength": 1},
        "priority": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
        "routes": {"$ref": "#/$defs/count"},
        "targets": {"$ref": "#/$defs/count"},
        "route_ids": {"$ref": "#/$defs/strings"},
        "target_ids": {"$ref": "#/$defs/strings"},
        "convergence_hotspot_ids": {"$ref": "#/$defs/strings"},
        "validation_campaign_ids": {"$ref": "#/$defs/strings"},
        "validation_test_hotspot_ids": {"type": "array", "maxItems": 100, "items": {"type": "string", "pattern": "^test-hotspot-[0-9a-f]{16}$"}},
        "shared_validation_test_files": {"$ref": "#/$defs/count"},
        "campaigns_by_review_tier": {"$ref": "#/$defs/reviewTierCounts"},
        "campaigns_revision_mismatched": {"$ref": "#/$defs/count"},
        "campaigns_revision_unbound": {"$ref": "#/$defs/count"},
        "campaigns_with_uncovered_changed_lines": {"$ref": "#/$defs/count"},
        "campaigns_with_runtime_observation_gaps": {"$ref": "#/$defs/count"},
        "highest_campaign_review_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "routes_by_priority": {"$ref": "#/$defs/priorityCounts"},
        "validation_statuses": {"$ref": "#/$defs/validationCounts"},
        "recommended_action": {"type": "string", "minLength": 1}
      }
    },
    "unrouted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "target", "owners", "reason", "recommended_action"],
      "properties": {
        "priority": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
        "target": {"$ref": "#/$defs/target"},
        "owners": {"$ref": "#/$defs/strings"},
        "reason": {"type": "string", "minLength": 1},
        "recommended_action": {"type": "string", "minLength": 1}
      }
    }
  }
}
