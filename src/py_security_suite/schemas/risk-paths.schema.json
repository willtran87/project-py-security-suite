{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:risk-paths:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "schema_id", "authoritative", "purpose", "summary",
    "evidence_availability", "routes", "convergence_hotspots",
    "owner_work_queues", "unrouted_targets", "truncation",
    "interpretation_limits", "references"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "schema_id": {"const": "urn:project-py-security-suite:risk-paths:1.0"},
    "authoritative": {"const": false},
    "purpose": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_available", "reachability_available", "entry_points",
        "candidate_targets", "targets_analyzed", "finding_targets", "sink_surface_targets",
        "routed_targets", "unrouted_targets", "routed_findings",
        "routed_sink_surfaces", "runtime_observed_routes",
        "coverage_gap_routes", "validation_gap_routes",
        "validation_assessed_routes", "validation_unassessed_routes", "owned_routes",
        "convergence_hotspots", "shared_control_points",
        "routes_in_convergence_hotspots", "owner_work_queues",
        "routes_by_priority"
      ],
      "properties": {
        "graph_available": {"type": "boolean"},
        "reachability_available": {"type": "boolean"},
        "entry_points": {"$ref": "#/$defs/count"},
        "candidate_targets": {"$ref": "#/$defs/count"},
        "targets_analyzed": {"$ref": "#/$defs/count"},
        "finding_targets": {"$ref": "#/$defs/count"},
        "sink_surface_targets": {"$ref": "#/$defs/count"},
        "routed_targets": {"$ref": "#/$defs/count"},
        "unrouted_targets": {"$ref": "#/$defs/count"},
        "routed_findings": {"$ref": "#/$defs/count"},
        "routed_sink_surfaces": {"$ref": "#/$defs/count"},
        "runtime_observed_routes": {"$ref": "#/$defs/count"},
        "coverage_gap_routes": {"$ref": "#/$defs/count"},
        "validation_gap_routes": {"$ref": "#/$defs/count"},
        "validation_assessed_routes": {"$ref": "#/$defs/count"},
        "validation_unassessed_routes": {"$ref": "#/$defs/count"},
        "owned_routes": {"$ref": "#/$defs/count"},
        "convergence_hotspots": {"$ref": "#/$defs/count"},
        "shared_control_points": {"$ref": "#/$defs/count"},
        "routes_in_convergence_hotspots": {"$ref": "#/$defs/count"},
        "owner_work_queues": {"$ref": "#/$defs/count"},
        "routes_by_priority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["P0", "P1", "P2", "P3", "P4"],
          "properties": {
            "P0": {"$ref": "#/$defs/count"},
            "P1": {"$ref": "#/$defs/count"},
            "P2": {"$ref": "#/$defs/count"},
            "P3": {"$ref": "#/$defs/count"},
            "P4": {"$ref": "#/$defs/count"}
          }
        }
      }
    },
    "evidence_availability": {
      "type": "object",
      "additionalProperties": {"type": "boolean"},
      "minProperties": 1
    },
    "routes": {
      "type": "array",
      "maxItems": 250,
      "items": {"$ref": "#/$defs/route"}
    },
    "convergence_hotspots": {
      "type": "array",
      "maxItems": 50,
      "items": {"$ref": "#/$defs/convergenceHotspot"}
    },
    "owner_work_queues": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/ownerQueue"}
    },
    "unrouted_targets": {
      "type": "array",
      "maxItems": 250,
      "items": {"$ref": "#/$defs/unrouted"}
    },
    "truncation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_files_omitted", "entry_points_omitted", "targets_omitted",
        "routes_omitted", "unrouted_targets_omitted",
        "convergence_hotspots_omitted", "owner_work_queues_omitted"
      ],
      "properties": {
        "graph_files_omitted": {"$ref": "#/$defs/count"},
        "entry_points_omitted": {"$ref": "#/$defs/count"},
        "targets_omitted": {"$ref": "#/$defs/count"},
        "routes_omitted": {"$ref": "#/$defs/count"},
        "unrouted_targets_omitted": {"$ref": "#/$defs/count"},
        "convergence_hotspots_omitted": {"$ref": "#/$defs/count"},
        "owner_work_queues_omitted": {"$ref": "#/$defs/count"}
      }
    },
    "interpretation_limits": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "references": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "strings": {
      "type": "array", "items": {"type": "string", "minLength": 1}
    },
    "nullableString": {"type": ["string", "null"]},
    "entryPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "declared_as", "path", "line"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "declared_as": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "line": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "id", "finding_id", "path", "line", "label", "domain",
        "area", "severity", "tools", "classifications"
      ],
      "properties": {
        "kind": {"enum": ["finding", "sink-surface"]},
        "id": {"type": "string", "minLength": 1},
        "finding_id": {"$ref": "#/$defs/nullableString"},
        "path": {"type": "string", "minLength": 1},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "label": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "area": {"type": "string", "minLength": 1},
        "severity": {"$ref": "#/$defs/nullableString"},
        "tools": {"$ref": "#/$defs/strings"},
        "classifications": {"$ref": "#/$defs/strings"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "relation"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "relation": {"type": "string", "minLength": 1}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reachability_states", "observations"],
      "properties": {
        "reachability_states": {"$ref": "#/$defs/strings"},
        "observations": {"$ref": "#/$defs/strings"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed_line", "line_covered", "coverage_percent",
        "mapped_test_files", "focused_test_status", "coverage_alignment",
        "gap_reasons", "action", "assessment_status", "assessment_reasons",
        "evidence_available"
      ],
      "properties": {
        "changed_line": {"type": ["boolean", "null"]},
        "line_covered": {"type": ["boolean", "null"]},
        "coverage_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "mapped_test_files": {"$ref": "#/$defs/strings"},
        "focused_test_status": {"$ref": "#/$defs/nullableString"},
        "coverage_alignment": {"$ref": "#/$defs/nullableString"},
        "gap_reasons": {"$ref": "#/$defs/strings"},
        "action": {"$ref": "#/$defs/nullableString"},
        "assessment_status": {"enum": ["aligned", "gap", "partial", "not-assessed"]},
        "assessment_reasons": {"$ref": "#/$defs/strings"},
        "evidence_available": {
          "type": "object",
          "additionalProperties": false,
          "required": ["change_scope", "coverage", "test_execution"],
          "properties": {
            "change_scope": {"type": "boolean"},
            "coverage": {"type": "boolean"},
            "test_execution": {"type": "boolean"}
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id", "priority", "entry_point", "target", "hop_count",
        "files", "edges", "owners", "runtime_context", "validation",
        "correlations", "convergence_hotspot_ids", "recommended_action",
        "evidence_artifacts"
      ],
      "properties": {
        "route_id": {"type": "string", "pattern": "^route-[0-9a-f]{16}$"},
        "priority": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
        "entry_point": {"$ref": "#/$defs/entryPoint"},
        "target": {"$ref": "#/$defs/target"},
        "hop_count": {"type": "integer", "minimum": 0, "maximum": 8},
        "files": {"type": "array", "minItems": 1, "maxItems": 9, "items": {"type": "string", "minLength": 1}},
        "edges": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/edge"}},
        "owners": {"$ref": "#/$defs/strings"},
        "runtime_context": {"$ref": "#/$defs/runtime"},
        "validation": {"$ref": "#/$defs/validation"},
        "correlations": {"type": "object"},
        "convergence_hotspot_ids": {"$ref": "#/$defs/strings"},
        "recommended_action": {"type": "string", "minLength": 1},
        "evidence_artifacts": {"$ref": "#/$defs/strings"}
      }
    },
    "validationCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aligned", "gap", "partial", "not-assessed"],
      "properties": {
        "aligned": {"$ref": "#/$defs/count"},
        "gap": {"$ref": "#/$defs/count"},
        "partial": {"$ref": "#/$defs/count"},
        "not-assessed": {"$ref": "#/$defs/count"}
      }
    },
    "priorityCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["P0", "P1", "P2", "P3", "P4"],
      "properties": {
        "P0": {"$ref": "#/$defs/count"},
        "P1": {"$ref": "#/$defs/count"},
        "P2": {"$ref": "#/$defs/count"},
        "P3": {"$ref": "#/$defs/count"},
        "P4": {"$ref": "#/$defs/count"}
      }
    },
    "convergenceHotspot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hotspot_id", "path", "kind", "priority", "route_ids", "target_ids",
        "finding_ids", "entry_point_ids", "tools", "owners",
        "validation_statuses", "mapped_test_files", "evidence_artifacts",
        "recommended_action"
      ],
      "properties": {
        "hotspot_id": {"type": "string", "pattern": "^hotspot-[0-9a-f]{16}$"},
        "path": {"type": "string", "minLength": 1},
        "kind": {"enum": ["target-concentration", "shared-transit", "mixed"]},
        "priority": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
        "route_ids": {"type": "array", "minItems": 2, "items": {"type": "string", "pattern": "^route-[0-9a-f]{16}$"}},
        "target_ids": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "finding_ids": {"$ref": "#/$defs/strings"},
        "entry_point_ids": {"$ref": "#/$defs/strings"},
        "tools": {"$ref": "#/$defs/strings"},
        "owners": {"$ref": "#/$defs/strings"},
        "validation_statuses": {"$ref": "#/$defs/validationCounts"},
        "mapped_test_files": {"$ref": "#/$defs/strings"},
        "evidence_artifacts": {"$ref": "#/$defs/strings"},
        "recommended_action": {"type": "string", "minLength": 1}
      }
    },
    "ownerQueue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queue_id", "owner", "priority", "routes", "targets", "route_ids",
        "target_ids", "convergence_hotspot_ids", "routes_by_priority",
        "validation_statuses", "recommended_action"
      ],
      "properties": {
        "queue_id": {"type": "string", "pattern": "^queue-[0-9a-f]{16}$"},
        "owner": {"type": "string", "minLength": 1},
        "priority": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
        "routes": {"$ref": "#/$defs/count"},
        "targets": {"$ref": "#/$defs/count"},
        "route_ids": {"$ref": "#/$defs/strings"},
        "target_ids": {"$ref": "#/$defs/strings"},
        "convergence_hotspot_ids": {"$ref": "#/$defs/strings"},
        "routes_by_priority": {"$ref": "#/$defs/priorityCounts"},
        "validation_statuses": {"$ref": "#/$defs/validationCounts"},
        "recommended_action": {"type": "string", "minLength": 1}
      }
    },
    "unrouted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "target", "owners", "reason", "recommended_action"],
      "properties": {
        "priority": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
        "target": {"$ref": "#/$defs/target"},
        "owners": {"$ref": "#/$defs/strings"},
        "reason": {"type": "string", "minLength": 1},
        "recommended_action": {"type": "string", "minLength": 1}
      }
    }
  }
}
