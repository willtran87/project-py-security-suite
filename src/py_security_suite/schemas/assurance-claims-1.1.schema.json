{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:assurance-claims:1.1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "framework", "claims"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "framework": {"type": "object", "additionalProperties": false, "required": ["name", "version", "reference"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "reference": {"type": "string", "format": "uri"}}},
    "claims": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["control", "claim", "result", "evidence", "blocking_reasons"], "properties": {"control": {"type": "string"}, "claim": {"type": "string"}, "result": {"enum": ["satisfied", "not_satisfied"]}, "evidence": {"type": "array", "items": {"type": "string"}}, "blocking_reasons": {"type": "array", "items": {"type": "string"}}}}}
  }
}
