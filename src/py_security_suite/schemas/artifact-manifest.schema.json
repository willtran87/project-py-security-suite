{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:artifact-manifest:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "algorithm", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "algorithm": {"const": "sha256"},
    "artifacts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0, "maximum": 8589934592}
        }
      }
    }
  }
}
