{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:operational-trend:1.3",
  "title": "Operational trend with validation ledger and assessment-scope continuity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authoritative", "scope", "summary", "delta", "comparison", "validation_owner_history", "scanner_history", "anomalies", "timeline"],
  "properties": {
    "schema_version": {"const": "1.3"},
    "authoritative": {"const": false},
    "scope": {"type": "string", "minLength": 1},
    "summary": {"type": "object"},
    "delta": {"type": "object", "additionalProperties": {"type": "integer"}},
    "comparison": {
      "type": "object",
      "required": ["validation_evidence_comparable", "validation_comparability_reasons", "new_validation_subject_ids", "resolved_validation_subject_ids", "unchanged_validation_subject_ids", "validation_state_transitions", "validation_owner_delta"],
      "properties": {
        "validation_evidence_comparable": {"type": "boolean"},
        "validation_comparability_reasons": {"type": "array", "maxItems": 4, "items": {"type": "string", "minLength": 1}},
        "new_validation_subject_ids": {"type": "array", "items": {"type": "string"}},
        "resolved_validation_subject_ids": {"type": "array", "items": {"type": "string"}},
        "unchanged_validation_subject_ids": {"type": "array", "items": {"type": "string"}},
        "validation_state_transitions": {"type": "array", "items": {"type": "object"}},
        "validation_owner_delta": {"type": "array", "items": {"type": "object"}}
      }
    },
    "validation_owner_history": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "observations", "first_subjects", "latest_subjects", "comparable", "delta"],
        "properties": {
          "owner": {"type": "string", "minLength": 1, "maxLength": 256},
          "observations": {
            "type": "array",
            "minItems": 2,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["scan_id", "evidence_available", "subjects"],
              "properties": {
                "scan_id": {"type": "string", "minLength": 1},
                "evidence_available": {"type": "boolean"},
                "subjects": {"type": "integer", "minimum": 0}
              }
            }
          },
          "first_subjects": {"type": "integer", "minimum": 0},
          "latest_subjects": {"type": "integer", "minimum": 0},
          "comparable": {"type": "boolean"},
          "delta": {"type": ["integer", "null"]}
        }
      }
    },
    "scanner_history": {"type": "array", "items": {"type": "object"}},
    "anomalies": {"type": "array", "items": {"type": "object"}},
    "timeline": {
      "type": "array",
      "minItems": 2,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["scan_id", "checksums_sha256", "validation_evidence_available", "validation_ledger_available", "validation_assessment_available", "validation_assessment_reason", "validation_assessment_scope", "validation_alignment_items", "validation_subjects"],
        "properties": {
          "scan_id": {"type": "string", "minLength": 1},
          "checksums_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "validation_evidence_available": {"type": "boolean"},
          "validation_ledger_available": {"type": "boolean"},
          "validation_assessment_available": {"type": "boolean"},
          "validation_assessment_reason": {"type": "string", "minLength": 1},
          "validation_assessment_scope": {"type": ["object", "null"]},
          "validation_alignment_items": {"type": "integer", "minimum": 0},
          "validation_subjects": {"type": "array", "maxItems": 10000, "items": {"type": "object"}}
        }
      }
    }
  }
}
