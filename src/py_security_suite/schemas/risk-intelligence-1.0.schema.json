{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:risk-intelligence:1.0",
  "type": "object", "additionalProperties": true,
  "required": ["schema_version", "configured", "enriched_findings", "snapshots"],
  "properties": {"schema_version": {"const": "1.0"}, "configured": {"type": "boolean"}, "enriched_findings": {"type": "integer", "minimum": 0}, "vex_formats": {"type": "array", "uniqueItems": true, "items": {"enum": ["cyclonedx", "openvex", "csaf"]}}, "vex_versions": {"type": "object", "additionalProperties": false, "properties": {"cyclonedx": {"type": "array", "uniqueItems": true, "items": {"const": "1.7"}}, "openvex": {"type": "array", "uniqueItems": true, "items": {"const": "0.2"}}, "csaf": {"type": "array", "uniqueItems": true, "items": {"const": "2.0"}}}}, "snapshots": {"type": "object"}, "errors": {"type": "array", "items": {"type": "string"}}}
}
