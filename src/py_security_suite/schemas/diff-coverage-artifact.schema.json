{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:diff-coverage-artifact:1.0",
  "type": "object",
  "required": ["schema_version", "minimum_percent", "src_stats"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "minimum_percent": {"type": "number", "minimum": 0, "maximum": 100},
    "percent_covered": {"type": "number", "minimum": 0, "maximum": 100},
    "total_num_lines": {"type": "integer", "minimum": 0},
    "total_num_violations": {"type": "integer", "minimum": 0},
    "src_stats": {"type": "object", "maxProperties": 250000, "additionalProperties": {"type": "object"}}
  }
}
