{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:llm-adversarial-proposal:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_sha256", "source_sha256", "campaign_id", "model_sha256", "provider_sha256", "prompt_template_sha256", "hypothesis", "proposed_tests"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_sha256": {"$ref": "#/$defs/digest"},
    "source_sha256": {"$ref": "#/$defs/digest"},
    "campaign_id": {"type": "string", "pattern": "^llm-campaign-[0-9a-f]{20}$"},
    "model_sha256": {"$ref": "#/$defs/digest"},
    "provider_sha256": {"$ref": "#/$defs/digest"},
    "prompt_template_sha256": {"$ref": "#/$defs/digest"},
    "hypothesis": {"type": "string", "minLength": 1, "maxLength": 2000},
    "proposed_tests": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/test"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tool": {"enum": ["atheris", "authorization-security", "codeql", "crosshair", "hypothesis", "mutmut", "playwright", "pysa", "restler", "schemathesis", "semgrep"]},
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expected", "deterministic", "llm_judge_sufficient"],
      "properties": {
        "kind": {"type": "string", "minLength": 1, "maxLength": 100},
        "expected": {"type": "string", "minLength": 1, "maxLength": 1000},
        "deterministic": {"const": true},
        "llm_judge_sufficient": {"const": false}
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "description"],
      "properties": {
        "present": {"const": true},
        "description": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "framework", "tool", "command", "objective", "oracle", "negative_control", "mutation_validation"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 160},
        "path": {"type": "string", "pattern": "^generated-tests/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\x00]{1,480}$"},
        "framework": {"type": "string", "minLength": 1, "maxLength": 100},
        "tool": {"$ref": "#/$defs/tool"},
        "command": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
        "objective": {"type": "string", "minLength": 1, "maxLength": 1000},
        "oracle": {"$ref": "#/$defs/oracle"},
        "negative_control": {"$ref": "#/$defs/control"},
        "mutation_validation": {"$ref": "#/$defs/control"}
      }
    }
  }
}
