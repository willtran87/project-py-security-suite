{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:scanner-trust-catalog:1.0",
  "title": "Approved scanner trust catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "catalog_id", "revision", "entries"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "approved"},
    "catalog_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "revision": {"type": "string", "minLength": 1, "maxLength": 200},
    "entries": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "role", "sha256", "version", "source", "approved_by", "expires"],
        "properties": {
          "tool": {"type": "string", "minLength": 1, "maxLength": 100},
          "role": {"enum": ["primary", "auxiliary"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "version": {"type": "string", "minLength": 1, "maxLength": 500},
          "source": {"type": "string", "minLength": 1, "maxLength": 500},
          "approved_by": {"type": "string", "minLength": 1, "maxLength": 500},
          "expires": {"type": "string", "format": "date"},
          "platforms": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
