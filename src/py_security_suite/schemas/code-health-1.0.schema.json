{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:code-health:1.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "analysis", "files_analyzed", "complete", "truncated", "issues_detected", "issues", "parse_errors_detected", "parse_errors_omitted", "parse_errors", "thresholds", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "analysis": {"const": "python-cognitive-complexity-size-coupling-and-duplication"},
    "files_analyzed": {"type": "integer", "minimum": 0, "maximum": 50000},
    "complete": {"type": "boolean"},
    "truncated": {"type": "boolean"},
    "issues_detected": {"type": "integer", "minimum": 0},
    "issues": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/issue"}},
    "parse_errors_detected": {"type": "integer", "minimum": 0},
    "parse_errors_omitted": {"type": "integer", "minimum": 0},
    "parse_errors": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["cognitive_complexity", "function_lines", "parameters", "class_lines", "duplicate_function_lines", "semantic_clone_lines"],
      "properties": {"cognitive_complexity": {"const": 15}, "function_lines": {"const": 100}, "parameters": {"const": 8}, "class_lines": {"const": 800}, "duplicate_function_lines": {"const": 12}, "semantic_clone_lines": {"const": 20}}
    },
    "limitations": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
  },
  "$defs": {
    "duplicate": {
      "type": "object", "additionalProperties": false, "required": ["path", "line", "end_line", "name"],
      "properties": {"path": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1}, "name": {"type": "string", "minLength": 1}}
    },
    "issue": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "path", "line", "end_line", "symbol", "value", "threshold", "duplicates"],
      "properties": {
        "kind": {"enum": ["cognitive-complexity", "long-function", "parameter-coupling", "large-class", "duplicate-function", "semantic-clone"]},
        "path": {"type": "string", "minLength": 1, "maxLength": 1000},
        "line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1},
        "symbol": {"type": "string", "minLength": 1, "maxLength": 500},
        "value": {"type": "integer", "minimum": 1}, "threshold": {"type": "integer", "minimum": 1},
        "duplicates": {"type": "array", "maxItems": 19, "items": {"$ref": "#/$defs/duplicate"}}
      }
    }
  }
}
