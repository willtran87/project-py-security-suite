{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:evidence-pack:1.0",
  "title": "Project Python Security Suite evidence pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "closed_set",
    "authoritative",
    "scope",
    "report",
    "files",
    "required_authorities"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "closed_set": { "const": true },
    "authoritative": { "const": false },
    "scope": { "type": "string", "minLength": 1 },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scan_id", "checksums_sha256", "outcome"],
      "properties": {
        "scan_id": { "type": "string", "minLength": 1 },
        "checksums_sha256": { "$ref": "#/$defs/digest" },
        "outcome": { "enum": ["pass", "warn", "fail", "incomplete"] }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/digest" },
          "size_bytes": { "type": "integer", "minimum": 0, "maximum": 134217728 }
        }
      }
    },
    "required_authorities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
