{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:report-inspection-verification:1.1",
  "title": "Python Security Suite report inspection verification receipt",
  "description": "Portable evidence that an inspection sidecar exactly matched a sealed report at a caller-selected action limit.",
  "type": "object",
  "required": [
    "schema_version",
    "schema_id",
    "verified",
    "inspection_schema_id",
    "scan_id",
    "inspection_sha256",
    "report_checksums_sha256",
    "action_limit",
    "top_actions_verified"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "schema_id": {
      "const": "urn:project-py-security-suite:schema:report-inspection-verification:1.1"
    },
    "verified": {
      "const": true
    },
    "inspection_schema_id": {
      "const": "urn:project-py-security-suite:schema:report-inspection:1.1"
    },
    "scan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "inspection_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "report_checksums_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "action_limit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "top_actions_verified": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    }
  }
}
