{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:portfolio-dashboard:1.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "authoritative", "scope", "summary", "attention", "reports"],
  "properties": {
    "schema_version": {"const": "1.0"}, "authoritative": {"const": false}, "scope": {"type": "string"},
    "summary": {"type": "object"}, "attention": {"type": "array", "items": {"type": "object"}},
    "reports": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"type": "object"}}
  }
}
