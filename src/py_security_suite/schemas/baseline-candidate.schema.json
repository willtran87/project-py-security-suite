{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:baseline-candidate:1.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "status", "authoritative", "scope", "report", "baseline", "requirements"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["candidate", "ineligible"]},
    "authoritative": {"const": false},
    "scope": {"type": "string", "minLength": 1},
    "report": {"type": "object"},
    "baseline": {"type": "object"},
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
