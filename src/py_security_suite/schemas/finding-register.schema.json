{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:finding-register:1.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "authoritative", "scope", "report", "previous_register_sha256", "summary", "records"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "authoritative": {"const": false},
    "scope": {"type": "string", "minLength": 1},
    "report": {"type": "object"},
    "previous_register_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "summary": {"type": "object"},
    "records": {"type": "array", "maxItems": 100000, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "finding_id", "title", "severity", "blocking", "lifecycle", "first_seen", "last_seen", "resolved_at", "occurrences", "owners", "sla"],
      "properties": {
        "identity": {"type": "string", "minLength": 1}, "finding_id": {"type": "string"}, "title": {"type": "string"},
        "severity": {"type": "string"}, "blocking": {"type": "boolean"},
        "lifecycle": {"enum": ["open", "reopened", "resolved"]},
        "first_seen": {"type": "string", "format": "date-time"}, "last_seen": {"type": "string", "format": "date-time"},
        "resolved_at": {"type": ["string", "null"], "format": "date-time"},
        "occurrences": {"type": "integer", "minimum": 1}, "owners": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "sla": {"type": "object"}
      }
    }}
  }
}
