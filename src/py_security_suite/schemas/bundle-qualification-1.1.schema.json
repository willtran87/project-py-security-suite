{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:bundle-qualification:1.1",
  "title": "Scanner bundle qualification with behavioral evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema_id", "authoritative", "qualification_scope", "qualification_id", "target", "profile", "platform", "decision", "summary", "behavioral_evidence", "adapter_failures", "context_errors", "actions", "tools", "scope"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "schema_id": {"const": "urn:project-py-security-suite:schema:bundle-qualification:1.1"},
    "authoritative": {"const": false},
    "qualification_scope": {"enum": ["static-readiness", "static-readiness+behavioral-evidence"]},
    "qualification_id": {"type": "string", "pattern": "^qualification-[0-9a-f]{24}$"},
    "target": {"$ref": "#/$defs/text"},
    "profile": {"$ref": "#/$defs/text"},
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "machine", "python"],
      "properties": {
        "system": {"$ref": "#/$defs/text"},
        "machine": {"$ref": "#/$defs/text"},
        "python": {"$ref": "#/$defs/text"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "adapter_contracts", "profile_readiness", "behavioral_evidence", "scanner_execution_performed", "release_approval"],
      "properties": {
        "disposition": {"enum": ["qualify", "block"]},
        "adapter_contracts": {"enum": ["pass", "fail"]},
        "profile_readiness": {"enum": ["ready", "not_ready"]},
        "behavioral_evidence": {"enum": ["not_required", "required_missing", "pass", "fail"]},
        "scanner_execution_performed": {"const": false},
        "release_approval": {"const": false}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registered_adapters", "conformant_adapters", "adapter_checks", "selected_controls", "applicable_controls", "ready_controls", "required_applicable", "required_ready", "not_applicable", "attention", "observed_digests", "organization_approved", "effectiveness_labels", "effectiveness_tools"],
      "properties": {
        "registered_adapters": {"$ref": "#/$defs/count"},
        "conformant_adapters": {"$ref": "#/$defs/count"},
        "adapter_checks": {"$ref": "#/$defs/count"},
        "selected_controls": {"$ref": "#/$defs/count"},
        "applicable_controls": {"$ref": "#/$defs/count"},
        "ready_controls": {"$ref": "#/$defs/count"},
        "required_applicable": {"$ref": "#/$defs/count"},
        "required_ready": {"$ref": "#/$defs/count"},
        "not_applicable": {"$ref": "#/$defs/count"},
        "attention": {"$ref": "#/$defs/count"},
        "observed_digests": {"$ref": "#/$defs/count"},
        "organization_approved": {"$ref": "#/$defs/count"},
        "effectiveness_labels": {"$ref": "#/$defs/count"},
        "effectiveness_tools": {"$ref": "#/$defs/count"}
      }
    },
    "behavioral_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "decision", "required", "sha256", "verdict", "corpus_id", "report_checksums_sha256", "report_scan_id", "labels", "positive_labels", "negative_labels", "tools", "tool_names", "required_tools", "missing_required_tools", "identity_mismatches", "tool_bindings", "minimum_labels", "minimum_tools", "required_action"],
      "properties": {
        "status": {"enum": ["not_provided", "verified"]},
        "decision": {"enum": ["not_required", "required_missing", "pass", "fail"]},
        "required": {"type": "boolean"},
        "sha256": {"$ref": "#/$defs/nullableSha256"},
        "verdict": {"enum": ["pass", "fail", null]},
        "corpus_id": {"type": ["string", "null"], "maxLength": 200},
        "report_checksums_sha256": {"$ref": "#/$defs/nullableSha256"},
        "report_scan_id": {"type": ["string", "null"], "maxLength": 200},
        "labels": {"$ref": "#/$defs/count"},
        "positive_labels": {"$ref": "#/$defs/count"},
        "negative_labels": {"$ref": "#/$defs/count"},
        "tools": {"$ref": "#/$defs/count"},
        "tool_names": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/tool"}},
        "required_tools": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/tool"}},
        "missing_required_tools": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/tool"}},
        "identity_mismatches": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/tool"}},
        "tool_bindings": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool", "version", "report_sha256", "current_sha256", "completed", "unchanged", "matched"],
            "properties": {
              "tool": {"$ref": "#/$defs/tool"},
              "version": {"type": "string", "maxLength": 500},
              "report_sha256": {"$ref": "#/$defs/nullableSha256"},
              "current_sha256": {"$ref": "#/$defs/nullableSha256"},
              "completed": {"type": "boolean"},
              "unchanged": {"type": "boolean"},
              "matched": {"type": "boolean"}
            }
          }
        },
        "minimum_labels": {"type": "integer", "minimum": 0, "maximum": 10000},
        "minimum_tools": {"type": "integer", "minimum": 0, "maximum": 1000},
        "required_action": {"$ref": "#/$defs/text"}
      }
    },
    "adapter_failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapter", "failed_checks"],
        "properties": {
          "adapter": {"$ref": "#/$defs/text"},
          "failed_checks": {"type": "array", "items": {"$ref": "#/$defs/text"}}
        }
      }
    },
    "context_errors": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "blocking", "category", "subjects", "required_action"],
        "properties": {
          "priority": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
          "blocking": {"type": "boolean"},
          "category": {"$ref": "#/$defs/text"},
          "subjects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
          "required_action": {"$ref": "#/$defs/text"}
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "status", "category", "required", "entrypoint", "sha256", "integrity_verified", "organization_approved"],
        "properties": {
          "tool": {"$ref": "#/$defs/text"},
          "status": {"$ref": "#/$defs/text"},
          "category": {"$ref": "#/$defs/text"},
          "required": {"type": "boolean"},
          "entrypoint": {"type": ["string", "null"], "maxLength": 4096},
          "sha256": {"$ref": "#/$defs/nullableSha256"},
          "integrity_verified": {"type": ["boolean", "null"]},
          "organization_approved": {"type": "boolean"}
        }
      }
    },
    "scope": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "text": {"type": "string", "minLength": 1, "maxLength": 16000},
    "tool": {"type": "string", "minLength": 1, "maxLength": 200},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
  }
}
