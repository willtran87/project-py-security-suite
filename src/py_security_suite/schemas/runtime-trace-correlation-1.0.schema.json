{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:runtime-trace-correlation:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis", "complete", "evidence_sha256", "deployment_sha256", "boundary_graph_sha256", "authority_receipt", "coverage_policy", "coverage_policy_authority_receipt", "evidence", "coverage_requirements", "coverage_required", "coverage_observed", "coverage_percent", "trace_count", "allow_count", "deny_count", "traces", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "analysis": {"const": "deployment-pinned-request-to-sink-runtime-correlation"},
    "complete": {"type": "boolean"},
    "evidence_sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
    "deployment_sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
    "boundary_graph_sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
    "authority_receipt": {"type": ["object", "null"]},
    "coverage_policy": {"type": ["object", "null"]},
    "coverage_policy_authority_receipt": {"type": ["object", "null"]},
    "evidence": {"type": ["object", "null"]},
    "coverage_requirements": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/requirement"}},
    "coverage_required": {"type": "integer", "minimum": 0},
    "coverage_observed": {"type": "integer", "minimum": 0},
    "coverage_percent": {"type": "number", "minimum": 0, "maximum": 100},
    "trace_count": {"type": "integer", "minimum": 0},
    "allow_count": {"type": "integer", "minimum": 0},
    "deny_count": {"type": "integer", "minimum": 0},
    "traces": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/trace"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["entry", "authorization_decision", "operation", "sink", "source", "target"],
      "properties": {"entry": {"type": "string", "minLength": 1}, "authorization_decision": {"enum": ["allow", "deny"]}, "operation": {"type": "string", "minLength": 1}, "sink": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}}
    },
    "trace": {
      "type": "object", "additionalProperties": false,
      "required": ["trace_id", "request_id", "entry", "authorization_decision", "operation", "sink", "sink_observed", "source", "target", "span_count", "edge_sha256", "started_at", "ended_at"],
      "properties": {"trace_id": {"type": "string", "minLength": 16, "maxLength": 64}, "request_id": {"type": "string", "minLength": 1}, "entry": {"type": "string", "minLength": 1}, "authorization_decision": {"enum": ["allow", "deny"]}, "operation": {"type": "string", "minLength": 1}, "sink": {"type": "string", "minLength": 1}, "sink_observed": {"type": "boolean"}, "source": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}, "span_count": {"type": "integer", "minimum": 1}, "edge_sha256": {"$ref": "#/$defs/digest"}, "started_at": {"type": "string", "format": "date-time"}, "ended_at": {"type": "string", "format": "date-time"}}
    }
  }
}
