{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:benchmark-security-event-record:1.1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "log_sequence", "previous_event_sha256", "event", "event_sha256"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "log_sequence": {"type": "integer", "minimum": 1},
    "previous_event_sha256": {"$ref": "#/$defs/sha256"},
    "event": {"$ref": "#/$defs/event"},
    "event_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "occurred_at", "control", "outcome", "details_sha256"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "occurred_at": {"type": "string", "format": "date-time"},
        "control": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "outcome": {"enum": ["passed", "failed", "observed"]},
        "details_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
