{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:project-py-security-suite:schema:domain-assurance:1.0",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "analysis",
        "complete",
        "coverage_complete",
        "coverage_score",
        "policy_path",
        "policy_present",
        "enforce_inferred_domains",
        "files_analyzed",
        "domains_detected",
        "applicable_domains",
        "covered_domains",
        "status_counts",
        "domains",
        "parse_errors",
        "truncated",
        "claim_boundary"
    ],
    "properties": {
        "schema_version": {
            "const": "1.0"
        },
        "analysis": {
            "const": "cross-domain-applicability-policy-and-evidence-coverage"
        },
        "complete": {
            "type": "boolean"
        },
        "coverage_complete": {
            "type": "boolean"
        },
        "coverage_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
        },
        "policy_path": {
            "enum": [
                "security/domain-assurance-policy.json",
                null
            ]
        },
        "policy_present": {
            "type": "boolean"
        },
        "enforce_inferred_domains": {
            "type": "boolean"
        },
        "files_analyzed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 50000
        },
        "domains_detected": {
            "const": 33
        },
        "applicable_domains": {
            "type": "integer",
            "minimum": 0,
            "maximum": 33
        },
        "covered_domains": {
            "type": "integer",
            "minimum": 0,
            "maximum": 33
        },
        "status_counts": {
            "type": "object",
            "propertyNames": {
                "$ref": "#/$defs/status"
            },
            "additionalProperties": {
                "type": "integer",
                "minimum": 1,
                "maximum": 33
            }
        },
        "domains": {
            "type": "array",
            "minItems": 33,
            "maxItems": 33,
            "items": {
                "$ref": "#/$defs/domain"
            }
        },
        "parse_errors": {
            "type": "array",
            "maxItems": 100,
            "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
            }
        },
        "truncated": {
            "type": "boolean"
        },
        "claim_boundary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
        }
    },
    "$defs": {
        "domainName": {
            "enum": [
                "business-logic",
                "privacy-lifecycle",
                "resilience",
                "detection-engineering",
                "cryptographic-agility",
                "notebook-security",
                "messaging-security",
                "desktop-client-security",
                "firmware-iot-security",
                "web3-security",
                "graphql-security",
                "identity-assurance",
                "tenant-isolation",
                "abuse-resistance",
                "workload-identity",
                "integration-security",
                "incident-response-recovery",
                "data-integrity-lineage",
                "serverless-edge-security",
                "external-asset-communication",
                "ot-ics-safety",
                "privileged-control-plane",
                "distributed-temporal-correctness",
                "secure-human-interaction",
                "ml-model-data-supply-chain",
                "credential-secret-lifecycle",
                "observability-integrity",
                "developer-environment-security",
                "parser-content-security",
                "trust-safety",
                "confidential-computing-side-channels",
                "regulated-transaction-integrity",
                "physical-environmental-security"
            ]
        },
        "status": {
            "enum": [
                "not-applicable",
                "unmodeled",
                "partial",
                "covered"
            ]
        },
        "requirementKind": {
            "enum": [
                "state-transition",
                "value-conservation",
                "quota",
                "idempotency",
                "concurrency",
                "eligibility",
                "collection-purpose",
                "consent",
                "minimization",
