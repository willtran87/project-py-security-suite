{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:promotion-plan:1.0",
  "title": "Release promotion decision-support plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "authoritative", "scope", "report", "summary", "release_blockers", "lifecycle", "assurance_closure", "finding_evidence_quality", "baseline_comparability", "conditional_coverage", "scanner_reliability", "artifact_graph", "audiences", "retention", "next_actions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["ready", "blocked"]},
    "authoritative": {"const": false},
    "scope": {"type": "string", "minLength": 1, "maxLength": 1000},
    "report": {"$ref": "#/$defs/report"},
    "summary": {"type": "object"},
    "release_blockers": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "lifecycle": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/lifecycle"}},
    "assurance_closure": {"type": "array", "maxItems": 1000, "items": {"type": "object"}},
    "finding_evidence_quality": {"type": "array", "maxItems": 100000, "items": {"type": "object"}},
    "baseline_comparability": {"type": "object"},
    "conditional_coverage": {"type": "array", "maxItems": 100, "items": {"type": "object"}},
    "scanner_reliability": {"type": "object"},
    "artifact_graph": {"$ref": "#/$defs/graph"},
    "audiences": {"type": "object"},
    "retention": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "object"}},
    "next_actions": {"type": "array", "maxItems": 100000, "items": {"type": "object"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["scan_id", "checksums_sha256", "files_verified", "outcome"],
      "properties": {
        "scan_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "checksums_sha256": {"$ref": "#/$defs/digest"},
        "files_verified": {"type": "integer", "minimum": 1},
        "outcome": {"enum": ["pass", "warn", "fail", "incomplete"]}
      }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "status", "detail"],
      "properties": {
        "stage": {"enum": ["built", "scanned", "reviewed", "signed", "verified", "approved", "published"]},
        "status": {"enum": ["complete", "blocked", "not_evaluated"]},
        "detail": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "graph": {
      "type": "object", "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {"type": "array", "maxItems": 100000, "items": {"type": "object"}},
        "edges": {"type": "array", "maxItems": 200000, "items": {"type": "object"}}
      }
    }
  }
}
