{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:sdist-normalization:1.0",
  "title": "Source distribution normalization receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema_id", "authoritative", "kind", "source_date_epoch", "members", "uncompressed_file_bytes", "input_sha256", "output_sha256", "output_size_bytes"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "schema_id": { "const": "urn:project-py-security-suite:schema:sdist-normalization:1.0" },
    "authoritative": { "const": false },
    "kind": { "const": "sdist-normalization" },
    "source_date_epoch": { "type": "integer", "minimum": 0 },
    "members": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "uncompressed_file_bytes": { "type": "integer", "minimum": 0, "maximum": 4294967296 },
    "input_sha256": { "$ref": "#/$defs/sha256" },
    "output_sha256": { "$ref": "#/$defs/sha256" },
    "output_size_bytes": { "type": "integer", "minimum": 1, "maximum": 4294967296 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
