{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:project-py-security-suite:schema:benchmark-attestation:1.2",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "kind",
        "subject_sha256",
        "valid",
        "authority",
        "claims"
    ],
    "properties": {
        "schema_version": {
            "const": "1.2"
        },
        "kind": {
            "enum": [
                "trusted-time",
                "replay-protection",
                "contamination-manifest",
                "runner-sbom",
                "runner-provenance",
                "environment",
                "acceptance-criteria",
                "adapter-conformance",
                "runtime-observation",
                "external-isolation",
                "cleanup-capability"
            ]
        },
        "subject_sha256": {
            "$ref": "#/$defs/sha256"
        },
        "valid": {
            "const": true
        },
        "authority": {
            "$ref": "#/$defs/authority"
        },
        "claims": {
            "type": "object"
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "trusted-time"
                    }
                }
            },
            "then": {
                "properties": {
                    "authority": {
                        "properties": {
                            "role": {
                                "const": "trusted-time"
                            }
                        }
                    },
                    "claims": {
                        "$ref": "#/$defs/trustedTimeClaims"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "replay-protection"
                    }
                }
            },
            "then": {
                "properties": {
                    "authority": {
                        "properties": {
                            "role": {
                                "const": "replay-protection"
                            }
                        }
                    },
                    "claims": {
                        "$ref": "#/$defs/replayClaims"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "contamination-manifest"
                    }
                }
            },
            "then": {
                "properties": {
                    "authority": {
                        "properties": {
                            "role": {
                                "const": "contamination-manifest"
                            }
                        }
                    },
                    "claims": {
                        "$ref": "#/$defs/contaminationClaims"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "runner-sbom"
                    }
                }
            },
            "then": {
                "properties": {
                    "authority": {
                        "properties": {
                            "role": {
                                "const": "runner-sbom"
                            }
                        }
                    },
                    "claims": {
                        "$ref": "#/$defs/sbomClaims"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "runner-provenance"
                    }
                }
            },
            "then": {
                "properties": {
                    "authority": {
                        "properties": {
                            "role": {
                                "const": "runner-provenance"
                            }
                        }
                    },
                    "claims": {
                        "$ref": "#/$defs/provenanceClaims"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "environment"
                    }
                }
            },
            "then": {
                "properties": {
                    "authority": {
                        "properties": {
                            "role": {
                                "const": "environment"
                            }
                        }
                    },
                    "claims": {
                        "$ref": "#/$defs/environmentClaims"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "acceptance-criteria"
                    }
                }
            },
            "then": {
                "properties": {
                    "authority": {
                        "properties": {
                            "role": {
                                "const": "acceptance-criteria"
                            }
                        }
                    },
                    "claims": {
                        "$ref": "#/$defs/acceptanceClaims"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "adapter-conformance"
                    }
                }
            },
            "then": {
                "properties": {
                    "authority": {
                        "properties": {
                            "role": {
                                "const": "adapter-conformance"
                            }
                        }
                    },
                    "claims": {
                        "$ref": "#/$defs/conformanceClaims"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "runtime-observation"
                    }
                }
            },
            "then": {
                "properties": {
                    "authority": {
                        "properties": {
                            "role": {
                                "const": "runtime-observation"
                            }
                        }
                    },
                    "claims": {
                        "$ref": "#/$defs/runtimeClaims"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "external-isolation"
                    }
                }
            },
            "then": {
                "properties": {
                    "authority": {
                        "properties": {
                            "role": {
                                "const": "external-isolation"
                            }
                        }
                    },
                    "claims": {
                        "$ref": "#/$defs/isolationClaims"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "cleanup-capability"
                    }
                }
            },
            "then": {
                "properties": {
                    "authority": {
                        "properties": {
                            "role": {
                                "const": "cleanup-capability"
                            }
                        }
                    },
                    "claims": {
                        "$ref": "#/$defs/cleanupClaims"
                    }
                }
            }
        }
    ],
    "$defs": {
        "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
        },
        "authority": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "organization_id",
                "role",
                "issued_at",
                "expires_at",
                "revocation_status_sha256"
            ],
            "properties": {
                "organization_id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
                },
                "role": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "issued_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "expires_at": {
                    "type": "string",
                    "format": "date-time"
                },
                "revocation_status_sha256": {
                    "$ref": "#/$defs/sha256"
                }
            }
        },
        "trustedTimeClaims": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "rfc3161_verified",
                "monotonic_state_verified",
                "trusted_time_receipt_sha256",
                "trusted_time_sha256",
                "observed_at"
            ],
            "properties": {
                "rfc3161_verified": {
                    "const": true
                },
                "monotonic_state_verified": {
                    "const": true
                },
                "trusted_time_receipt_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "trusted_time_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "observed_at": {
                    "type": "string",
                    "format": "date-time"
                }
            }
        },
        "replayClaims": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "ledger_consumed",
                "nonce_unique",
                "ledger_receipt_sha256",
                "nonce_sha256"
            ],
            "properties": {
                "ledger_consumed": {
                    "const": true
                },
                "nonce_unique": {
                    "const": true
                },
                "ledger_receipt_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "nonce_sha256": {
                    "$ref": "#/$defs/sha256"
                }
            }
        },
        "contaminationClaims": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "checked",
                "contaminated",
                "contamination_manifest_path",
                "contamination_manifest_sha256"
            ],
            "properties": {
                "checked": {
                    "const": true
                },
                "contaminated": {
                    "const": false
                },
                "contamination_manifest_path": {
                    "$ref": "#/$defs/path"
                },
                "contamination_manifest_sha256": {
                    "$ref": "#/$defs/sha256"
                }
            }
        },
        "sbomClaims": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "validated",
                "format",
                "runner_image_sha256",
                "sbom_subject_sha256",
                "sbom_document_path",
                "sbom_document_sha256"
            ],
            "properties": {
                "validated": {
                    "const": true
                },
                "format": {
                    "enum": [
                        "CycloneDX-1.6",
                        "SPDX-2.3"
                    ]
                },
                "runner_image_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "sbom_subject_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "sbom_document_path": {
                    "$ref": "#/$defs/path"
                },
                "sbom_document_sha256": {
                    "$ref": "#/$defs/sha256"
                }
            }
        },
        "provenanceClaims": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "signature_verified",
                "predicate_type",
                "runner_image_sha256",
                "provenance_subject_sha256",
                "provenance_document_path",
                "provenance_document_sha256",
                "provenance_signature_format",
                "provenance_signature_path",
                "provenance_signature_sha256",
                "provenance_public_key_path",
                "provenance_public_key_sha256",
                "builder_id",
                "builder_organization_id",
                "build_type",
                "source_repository_uri",
                "source_revision_sha256",
                "resolved_dependencies_sha256",
                "resolved_dependencies_count"
            ],
            "properties": {
                "signature_verified": {
                    "const": true
                },
                "predicate_type": {
                    "const": "https://slsa.dev/provenance/v1"
                },
                "runner_image_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "provenance_subject_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "provenance_document_path": {
                    "$ref": "#/$defs/path"
                },
                "provenance_document_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "provenance_signature_format": {
                    "const": "dsse-ed25519"
                },
                "provenance_signature_path": {
                    "$ref": "#/$defs/path"
                },
                "provenance_signature_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "provenance_public_key_path": {
                    "$ref": "#/$defs/path"
                },
                "provenance_public_key_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "builder_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                },
                "builder_organization_id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
                },
                "build_type": {
                    "type": "string",
                    "pattern": "^https://",
                    "maxLength": 2048
                },
                "source_repository_uri": {
                    "type": "string",
                    "pattern": "^https://",
                    "maxLength": 2048
                },
                "source_revision_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "resolved_dependencies_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "resolved_dependencies_count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                }
            }
        },
        "environmentClaims": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "captured",
                "hermetic",
                "environment_sha256",
                "environment_document_path",
                "environment_document_sha256"
            ],
            "properties": {
                "captured": {
                    "const": true
                },
                "hermetic": {
                    "type": "boolean"
                },
                "environment_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "environment_document_path": {
                    "$ref": "#/$defs/path"
                },
                "environment_document_sha256": {
                    "$ref": "#/$defs/sha256"
                }
            }
        },
        "acceptanceClaims": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "pre_registered",
                "approved",
                "criteria_sha256",
                "thresholds_sha256",
                "protocol",
                "approved_before_execution",
                "approval_record_sha256"
            ],
            "properties": {
                "pre_registered": {
                    "const": true
                },
                "approved": {
                    "const": true
                },
                "criteria_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "thresholds_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "protocol": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "approved_before_execution": {
                    "const": true
                },
                "approval_record_sha256": {
                    "$ref": "#/$defs/sha256"
                }
            }
        },
        "conformanceClaims": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "passed",
                "parser_negative_controls_passed",
                "semantic_inversion_controls_passed",
                "adapter_spec_sha256",
                "runner_executable_sha256",
                "normalizer",
                "semantic_oracle_identity",
                "semantic_oracle_sha256",
                "deterministic_runs",
                "fixture_counts",
                "fixture_set_sha256",
                "output_sha256",
                "conformance_report_path",
                "conformance_report_sha256"
            ],
            "properties": {
                "passed": {
                    "const": true
                },
                "parser_negative_controls_passed": {
                    "const": true
                },
                "semantic_inversion_controls_passed": {
                    "const": true
                },
                "adapter_spec_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "runner_executable_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "normalizer": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                },
                "semantic_oracle_identity": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                },
                "semantic_oracle_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "deterministic_runs": {
                    "type": "integer",
                    "minimum": 3,
                    "maximum": 1000
                },
                "fixture_counts": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["golden", "malformed", "label_inverted"],
                    "properties": {
                        "golden": {"type": "integer", "minimum": 3, "maximum": 1000},
                        "malformed": {"type": "integer", "minimum": 3, "maximum": 1000},
                        "label_inverted": {"type": "integer", "minimum": 3, "maximum": 1000}
                    }
                },
                "fixture_set_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "output_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "conformance_report_path": {
                    "$ref": "#/$defs/path"
                },
                "conformance_report_sha256": {
                    "$ref": "#/$defs/sha256"
                }
            }
        },
        "runtimeClaims": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "resource_limits_observed",
                "network_policy_observed",
                "egress_transcript_complete",
                "isolation_mode",
                "target_sha256",
                "runner_image_sha256",
                "network_policy_sha256",
                "resource_limits_sha256",
                "egress_transcript_sha256",
                "environment_sha256",
                "minimum_repetitions",
                "power_analysis_path",
                "power_analysis_sha256",
                "leakage_check_path",
                "leakage_check_sha256",
                "duplicate_check_path",
                "duplicate_check_sha256",
                "holdout_sequestered",
                "achieved_power",
                "leakage_detected",
                "duplicate_count",
                "observation_report_path",
                "observation_report_sha256"
            ],
            "properties": {
                "resource_limits_observed": {
                    "const": true
                },
                "network_policy_observed": {
                    "const": true
                },
                "egress_transcript_complete": {
                    "const": true
                },
                "isolation_mode": {
                    "enum": [
                        "external-sandbox",
                        "oci"
                    ]
                },
                "target_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "runner_image_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "network_policy_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "resource_limits_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "egress_transcript_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "environment_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "minimum_repetitions": {
                    "type": "integer",
                    "minimum": 3,
                    "maximum": 1000
                },
                "power_analysis_path": {
                    "$ref": "#/$defs/path"
                },
                "power_analysis_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "leakage_check_path": {
                    "$ref": "#/$defs/path"
                },
                "leakage_check_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "duplicate_check_path": {
                    "$ref": "#/$defs/path"
                },
                "duplicate_check_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "holdout_sequestered": {
                    "const": true
                },
                "achieved_power": {
                    "type": "number",
                    "minimum": 0.8,
                    "maximum": 1
                },
                "leakage_detected": {
                    "const": false
                },
                "duplicate_count": {
                    "const": 0
                },
                "observation_report_path": {
                    "$ref": "#/$defs/path"
                },
                "observation_report_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "runtime_binary_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "runtime_capabilities_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "runtime_trust_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "runtime_name": {
                    "enum": [
                        "docker",
                        "podman",
                        "nerdctl"
                    ]
                },
                "runtime_version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                }
            }
        },
        "isolationClaims": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "isolation_enforced",
                "network_policy_enforced",
                "disposable_target",
                "receipt_subject_verified",
                "runner_image_pinned",
                "runner_sbom_matches_image",
                "runner_provenance_verified",
                "provenance_subject_matches_image",
                "resource_limits_enforced",
                "egress_transcript_complete",
                "runner_image_sha256",
                "resource_limits_sha256",
                "network_policy_sha256",
                "egress_transcript_sha256",
                "target_sha256"
            ],
            "properties": {
                "isolation_enforced": {
                    "const": true
                },
                "network_policy_enforced": {
                    "const": true
                },
                "disposable_target": {
                    "const": true
                },
                "receipt_subject_verified": {
                    "const": true
                },
                "runner_image_pinned": {
                    "const": true
                },
                "runner_sbom_matches_image": {
                    "const": true
                },
                "runner_provenance_verified": {
                    "const": true
                },
                "provenance_subject_matches_image": {
                    "const": true
                },
                "resource_limits_enforced": {
                    "const": true
                },
                "egress_transcript_complete": {
                    "const": true
                },
                "runner_image_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "resource_limits_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "network_policy_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "egress_transcript_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "target_sha256": {
                    "$ref": "#/$defs/sha256"
                }
            }
        },
        "cleanupClaims": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "cleanup_plan_validated",
                "destructive_scope_validated",
                "target_destroyed",
                "cleanup_validated",
                "cleanup_receipt_path",
                "cleanup_receipt_sha256",
                "target_sha256",
                "destruction_probe_sha256"
            ],
            "properties": {
                "cleanup_plan_validated": {
                    "const": true
                },
                "destructive_scope_validated": {
                    "const": true
                },
                "target_destroyed": {
                    "const": true
                },
                "cleanup_validated": {
                    "const": true
                },
                "cleanup_receipt_path": {
                    "$ref": "#/$defs/path"
                },
                "cleanup_receipt_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "target_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "destruction_probe_sha256": {
                    "$ref": "#/$defs/sha256"
                }
            }
        }
    }
}
