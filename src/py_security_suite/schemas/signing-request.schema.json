{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:signing-request:1.0",
  "title": "Controlled signing request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "authoritative", "scope", "report", "payload", "policy", "handoff"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "candidate"},
    "authoritative": {"const": false},
    "scope": {"type": "string", "minLength": 1, "maxLength": 1000},
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["scan_id", "checksums_sha256", "source_sha256", "outcome"],
      "properties": {
        "scan_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "checksums_sha256": {"$ref": "#/$defs/digest"},
        "source_sha256": {"$ref": "#/$defs/digest"},
        "outcome": {"enum": ["pass", "warn", "fail", "incomplete"]}
      }
    },
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "algorithm", "artifact_count", "subjects"],
      "properties": {
        "id": {"$ref": "#/$defs/digest"},
        "algorithm": {"const": "sha256-canonical-json"},
        "artifact_count": {"type": "integer", "minimum": 1, "maximum": 1000},
        "subjects": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/subject"}}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["exact_artifact_set_required", "signature_format", "organization_authorization_required", "private_key_material_permitted"],
      "properties": {
        "exact_artifact_set_required": {"const": true},
        "signature_format": {"const": "sigstore-bundle-v0.3"},
        "organization_authorization_required": {"const": true},
        "private_key_material_permitted": {"const": false}
      }
    },
    "handoff": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 500}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "sha256", "size_bytes"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^/\\\\]+$"},
        "sha256": {"$ref": "#/$defs/digest"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 2147483648}
      }
    }
  }
}
