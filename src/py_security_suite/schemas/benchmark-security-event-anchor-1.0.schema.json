{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:benchmark-security-event-anchor:1.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "analysis", "records", "head_event_sha256", "log_sha256", "anchored_at", "previous_anchor_sha256", "organization_id", "key_provider", "key_version", "signer_key_id", "public_key", "anchor_sha256", "signature"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "analysis": {"const": "benchmark-security-event-log-verification"},
    "records": {"type": "integer", "minimum": 1},
    "head_event_sha256": {"$ref": "#/$defs/sha256"}, "log_sha256": {"$ref": "#/$defs/sha256"},
    "anchored_at": {"type": "string", "format": "date-time"},
    "previous_anchor_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "organization_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "key_provider": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "key_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "signer_key_id": {"$ref": "#/$defs/sha256"}, "public_key": {"type": "string", "minLength": 40, "maxLength": 128},
    "anchor_sha256": {"$ref": "#/$defs/sha256"}, "signature": {"type": "string", "minLength": 80, "maxLength": 128}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
