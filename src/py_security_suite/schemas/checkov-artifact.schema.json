{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:checkov-artifact:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reports", "passed_checks", "failed_checks", "skipped_checks", "total_checks", "frameworks", "native_report_sha256", "native_report_size_bytes", "native_report_records", "native_report_utf8", "normalization_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "reports": {"type": "integer", "minimum": 1, "maximum": 10000},
    "passed_checks": {"type": "integer", "minimum": 0, "maximum": 10000000},
    "failed_checks": {"type": "integer", "minimum": 0, "maximum": 10000000},
    "skipped_checks": {"type": "integer", "minimum": 0, "maximum": 10000000},
    "total_checks": {"type": "integer", "minimum": 0, "maximum": 30000000},
    "frameworks": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
    "native_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "native_report_size_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
    "native_report_records": {"type": "integer", "minimum": 0, "maximum": 30000000},
    "native_report_utf8": {"type": "string", "minLength": 1, "maxLength": 67108864},
    "normalization_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
