{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:industry-assurance:1.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "analysis", "complete", "policy_present", "policy_path", "standards_registered", "benchmarks_registered", "assurance_profiles_available", "assurance_profiles_selected", "controls_assessed", "controls_satisfied", "procedures_assessed", "procedures_satisfied", "benchmarks_executed", "oscal_models_emitted", "interoperability", "artifact_contracts", "parse_errors", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "1.0"}, "analysis": {"const": "industry-standards-and-benchmark-assurance"}, "complete": {"type": "boolean"}, "policy_present": {"type": "boolean"}, "policy_path": {"type": ["string", "null"]},
    "standards_registered": {"type": "integer", "minimum": 0}, "benchmarks_registered": {"type": "integer", "minimum": 0}, "assurance_profiles_available": {"type": "integer", "minimum": 0}, "assurance_profiles_selected": {"type": "integer", "minimum": 0}, "controls_assessed": {"type": "integer", "minimum": 0}, "controls_satisfied": {"type": "integer", "minimum": 0}, "procedures_assessed": {"type": "integer", "minimum": 0}, "procedures_satisfied": {"type": "integer", "minimum": 0}, "benchmarks_executed": {"type": "integer", "minimum": 0}, "oscal_models_emitted": {"const": 7},
    "interoperability": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["format", "version", "status", "observed_versions", "evidence_artifacts"], "properties": {"format": {"type": "string"}, "version": {"type": "string"}, "status": {"enum": ["supported", "not-observed"]}, "observed_versions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "evidence_artifacts": {"type": "array", "items": {"type": "string"}}}}},
    "artifact_contracts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "parse_errors": {"type": "array", "items": {"type": "string"}}, "claim_boundary": {"type": "string", "minLength": 1}
  }
}
