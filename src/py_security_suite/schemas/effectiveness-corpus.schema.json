{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:effectiveness-corpus:2.0",
  "title": "Labeled scanner effectiveness corpus",
  "oneOf": [
    {"$ref": "#/$defs/legacy"},
    {"$ref": "#/$defs/governed"}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "match": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"tool": {"type": "string", "maxLength": 500}, "rule_id": {"type": "string", "maxLength": 500}, "path": {"type": "string", "maxLength": 500}, "classification": {"type": "string", "maxLength": 500}}},
    "legacyLabel": {"type": "object", "additionalProperties": false, "required": ["id", "expected", "match"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 200}, "expected": {"enum": ["finding", "clean"]}, "match": {"$ref": "#/$defs/match"}}},
    "governedLabel": {"type": "object", "additionalProperties": false, "required": ["id", "expected", "match", "cwe", "language", "parser_variant", "boundary_type", "severity", "mutation_operator", "fixture_path", "fixture_sha256"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 200}, "expected": {"enum": ["finding", "clean"]}, "match": {"$ref": "#/$defs/match"}, "cwe": {"type": "string", "minLength": 1, "maxLength": 160}, "language": {"type": "string", "minLength": 1, "maxLength": 160}, "parser_variant": {"type": "string", "minLength": 1, "maxLength": 160}, "boundary_type": {"type": "string", "minLength": 1, "maxLength": 160}, "severity": {"type": "string", "minLength": 1, "maxLength": 160}, "mutation_operator": {"type": "string", "minLength": 1, "maxLength": 160}, "fixture_path": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"}, "fixture_sha256": {"$ref": "#/$defs/digest"}}},
    "authorityCommon": {"type": "object", "properties": {"signer_id": {"$ref": "#/$defs/digest"}, "collector_id": {"type": "string", "minLength": 1, "maxLength": 160}, "signed_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"}, "public_key_file": {"type": "string", "minLength": 1, "maxLength": 500}, "public_key_sha256": {"$ref": "#/$defs/digest"}, "signature_file": {"type": "string", "minLength": 1, "maxLength": 500}, "signature_sha256": {"$ref": "#/$defs/digest"}}},
    "authority": {"oneOf": [{"allOf": [{"$ref": "#/$defs/authorityCommon"}, {"type": "object", "additionalProperties": false, "required": ["schema_version", "signer_id", "collector_id", "signed_at", "expires_at", "public_key_file", "public_key_sha256", "signature_file", "signature_sha256"], "properties": {"schema_version": {"const": "1.0"}, "signer_id": true, "collector_id": true, "signed_at": true, "expires_at": true, "public_key_file": true, "public_key_sha256": true, "signature_file": true, "signature_sha256": true}}]}, {"allOf": [{"$ref": "#/$defs/authorityCommon"}, {"type": "object", "additionalProperties": false, "required": ["schema_version", "algorithm", "signer_id", "collector_id", "signed_at", "expires_at", "public_key_file", "public_key_sha256", "signature_file", "signature_sha256"], "properties": {"schema_version": {"const": "2.0"}, "algorithm": {"enum": ["ed25519", "ecdsa-p256-sha256"]}, "signer_id": true, "collector_id": true, "signed_at": true, "expires_at": true, "public_key_file": true, "public_key_sha256": true, "signature_file": true, "signature_sha256": true}}]}]},
    "legacy": {"type": "object", "additionalProperties": false, "required": ["schema_version", "corpus_id", "revision", "labels"], "properties": {"schema_version": {"const": "1.0"}, "corpus_id": {"type": "string", "minLength": 1, "maxLength": 200}, "revision": {"type": "string", "minLength": 1, "maxLength": 200}, "labels": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/legacyLabel"}}}},
    "governed": {"type": "object", "additionalProperties": false, "required": ["schema_version", "corpus_id", "revision", "training_corpus_sha256", "holdout_labels_sha256", "minimum_authority_signatures", "authorities", "labels"], "properties": {"schema_version": {"const": "2.0"}, "corpus_id": {"type": "string", "minLength": 1, "maxLength": 200}, "revision": {"type": "string", "minLength": 1, "maxLength": 200}, "training_corpus_sha256": {"$ref": "#/$defs/digest"}, "holdout_labels_sha256": {"$ref": "#/$defs/digest"}, "minimum_authority_signatures": {"type": "integer", "minimum": 2, "maximum": 16}, "authorities": {"type": "array", "minItems": 2, "maxItems": 16, "items": {"$ref": "#/$defs/authority"}}, "labels": {"type": "array", "minItems": 25, "maxItems": 10000, "items": {"$ref": "#/$defs/governedLabel"}}}}
  }
}
