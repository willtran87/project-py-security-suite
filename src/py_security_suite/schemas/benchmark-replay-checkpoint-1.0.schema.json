{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:project-py-security-suite:schema:benchmark-replay-checkpoint:1.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "analysis", "ledger_identity_sha256", "sequence", "checkpoint_sha256", "updated_at", "receipt_sha256", "receipt_signature"],
  "properties": {"schema_version": {"const": "1.0"}, "analysis": {"const": "benchmark-replay-checkpoint"}, "ledger_identity_sha256": {"$ref": "#/$defs/digest"}, "sequence": {"type": "integer", "minimum": 1}, "checkpoint_sha256": {"$ref": "#/$defs/digest"}, "updated_at": {"type": "string", "format": "date-time"}, "receipt_sha256": {"$ref": "#/$defs/digest"}, "receipt_signature": {"$ref": "#/$defs/signature"}},
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}, "signature": {"type": "object", "additionalProperties": false, "required": ["algorithm", "signer_key_id", "organization_id", "key_provider", "key_version", "public_key", "signature"], "properties": {"algorithm": {"const": "Ed25519"}, "signer_key_id": {"$ref": "#/$defs/digest"}, "organization_id": {"$ref": "#/$defs/id"}, "key_provider": {"$ref": "#/$defs/id"}, "key_version": {"$ref": "#/$defs/id"}, "public_key": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"}, "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}}}}
}
