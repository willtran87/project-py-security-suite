{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:precommit-config:1.0",
  "type": "object",
  "required": ["schema_version", "schema_id", "authoritative", "status", "target", "output", "profile", "configuration", "hooks", "safety_controls", "scope"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "schema_id": {"const": "urn:project-py-security-suite:schema:precommit-config:1.0"},
    "authoritative": {"const": false},
    "status": {"const": "generated"},
    "target": {"type": "string", "minLength": 1},
    "output": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "configuration": {"type": "string", "minLength": 1},
    "hooks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "purpose", "command"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "command": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "safety_controls": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "scope": {"type": "string", "minLength": 1}
  }
}
