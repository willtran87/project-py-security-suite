{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:release-readiness:1.0",
  "title": "Unified release-readiness decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision", "scope", "report", "summary", "blockers", "controls"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "decision": {"enum": ["approved", "not_approved"]},
    "scope": {"type": "string", "minLength": 1},
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scan_id", "checksums_sha256", "files_verified"],
      "properties": {
        "scan_id": {"type": "string", "minLength": 1},
        "checksums_sha256": {"$ref": "#/$defs/digest"},
        "files_verified": {"type": "integer", "minimum": 1}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controls", "passed", "failed", "blocking_findings", "scanner_entrypoints", "scanner_trust_gaps"],
      "properties": {
        "controls": {"type": "integer", "minimum": 1},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "blocking_findings": {"type": "integer", "minimum": 0},
        "scanner_entrypoints": {"type": "integer", "minimum": 0},
        "scanner_trust_gaps": {"type": "integer", "minimum": 0}
      }
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "detail", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail"]},
          "detail": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
