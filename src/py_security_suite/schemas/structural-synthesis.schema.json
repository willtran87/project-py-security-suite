{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:structural-synthesis:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "authoritative",
    "purpose",
    "summary",
    "dead_code_assessments",
    "island_assessments",
    "import_cycles",
    "finding_assessments",
    "truncation",
    "interpretation_limits",
    "references"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "schema_id": {"const": "urn:project-py-security-suite:structural-synthesis:1.0"},
    "authoritative": {"const": false},
    "purpose": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dead_code_candidates",
        "likely_removable_dead_code_candidates",
        "likely_dynamic_dead_code_candidates",
        "islands_analyzed",
        "likely_removable_islands",
        "likely_dynamic_islands",
        "latent_attack_surface_islands",
        "import_cycles",
        "architecture_hotspots"
      ],
      "properties": {
        "dead_code_candidates": {"type": "integer", "minimum": 0},
        "likely_removable_dead_code_candidates": {"type": "integer", "minimum": 0},
        "likely_dynamic_dead_code_candidates": {"type": "integer", "minimum": 0},
        "islands_analyzed": {"type": "integer", "minimum": 0},
        "likely_removable_islands": {"type": "integer", "minimum": 0},
        "likely_dynamic_islands": {"type": "integer", "minimum": 0},
        "latent_attack_surface_islands": {"type": "integer", "minimum": 0},
        "import_cycles": {"type": "integer", "minimum": 0},
        "architecture_hotspots": {"type": "integer", "minimum": 0}
      }
    },
    "dead_code_assessments": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/deadCodeAssessment"}
    },
    "island_assessments": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/islandAssessment"}
    },
    "import_cycles": {
      "type": "array",
      "maxItems": 50,
      "items": {"$ref": "#/$defs/importCycle"}
    },
    "finding_assessments": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "type": "object",
        "required": ["finding_id", "kind"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["dead-code", "island", "import-cycle"]}
        }
      }
    },
    "truncation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dead_code_assessments_omitted", "island_assessments_omitted", "import_cycles_omitted"],
      "properties": {
        "dead_code_assessments_omitted": {"type": "integer", "minimum": 0},
        "island_assessments_omitted": {"type": "integer", "minimum": 0},
        "import_cycles_omitted": {"type": "integer", "minimum": 0}
      }
    },
    "interpretation_limits": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "references": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "deadCodeAssessment": {
      "type": "object",
      "required": [
        "finding_id", "path", "disposition", "confidence", "signals",
        "counter_signals", "reachability_states", "runtime_observations",
        "coverage_state", "inbound_symbol_references", "external_file_inbound",
        "recommended_action"
      ],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["likely-removable", "likely-dynamic", "needs-review"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "signals": {"type": "array", "items": {"type": "string"}},
        "counter_signals": {"type": "array", "items": {"type": "string"}},
        "reachability_states": {"type": "array", "items": {"enum": ["executable", "load-only", "disconnected"]}},
        "runtime_observations": {"type": "array", "items": {"type": "string"}},
        "coverage_state": {"enum": ["covered", "uncovered", "unknown"]},
        "inbound_symbol_references": {"type": "array"},
        "external_file_inbound": {"type": "array", "items": {"type": "string"}},
        "recommended_action": {"type": "string", "minLength": 1}
      }
    },
    "islandAssessment": {
      "type": "object",
      "required": [
        "island_id", "classification", "priority", "impact_score", "state",
        "lines_of_code", "paths", "runtime_observation", "external_inbound_files",
        "security_finding_ids", "dead_code_finding_ids", "tach_finding_ids",
        "evidence", "counter_evidence", "recommended_action"
      ],
      "properties": {
        "island_id": {"type": "string", "minLength": 1},
        "classification": {"enum": ["latent-attack-surface", "missing-entry-point", "likely-dynamic", "likely-removable", "orphaned-code-review"]},
        "priority": {"enum": ["high", "medium", "low"]},
        "impact_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "state": {"enum": ["executable", "load-only", "disconnected"]},
        "lines_of_code": {"type": "integer", "minimum": 0},
        "paths": {"type": "array", "items": {"type": "string"}},
        "runtime_observation": {"type": "string"},
        "external_inbound_files": {"type": "array", "items": {"type": "string"}},
        "security_finding_ids": {"type": "array", "items": {"type": "string"}},
        "dead_code_finding_ids": {"type": "array", "items": {"type": "string"}},
        "tach_finding_ids": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "counter_evidence": {"type": "array", "items": {"type": "string"}},
        "recommended_action": {"type": "string", "minLength": 1}
      }
    },
    "importCycle": {
      "type": "object",
      "required": ["cycle_id", "paths", "file_count", "internal_edge_count", "tach_finding_ids", "security_finding_ids", "priority", "recommended_action"],
      "properties": {
        "cycle_id": {"type": "string", "minLength": 1},
        "paths": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "file_count": {"type": "integer", "minimum": 2},
        "internal_edge_count": {"type": "integer", "minimum": 2},
        "tach_finding_ids": {"type": "array", "items": {"type": "string"}},
        "security_finding_ids": {"type": "array", "items": {"type": "string"}},
        "priority": {"enum": ["high", "medium", "low"]},
        "recommended_action": {"type": "string", "minLength": 1}
      }
    }
  }
}
