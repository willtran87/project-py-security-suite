        "fusion_available": {"type": "boolean"},
        "fusion_review_tier": {"enum": ["urgent", "elevated", "standard", "not-available"]},
        "corroboration": {"enum": ["single-tool", "contextual", "independent", "cross-stage", "not-available"]},
