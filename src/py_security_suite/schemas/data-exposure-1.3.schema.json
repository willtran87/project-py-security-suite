        "related_finding_ids": {"$ref": "#/$defs/strings"},
        "related_tools": {"$ref": "#/$defs/strings"},
        "changed_line": {"$ref": "#/$defs/nullableBoolean"},
        "line_covered": {"$ref": "#/$defs/nullableBoolean"},
        "coverage_percent": {"$ref": "#/$defs/nullableNumber"},
        "diff_coverage_percent": {"$ref": "#/$defs/nullableNumber"},
        "reachability_states": {"$ref": "#/$defs/strings"},
        "runtime_observations": {"$ref": "#/$defs/strings"},
        "graph_upstream_files": {"$ref": "#/$defs/nullableCount"},
        "graph_downstream_files": {"$ref": "#/$defs/nullableCount"},
        "graph_degree": {"$ref": "#/$defs/nullableCount"},
        "owners": {"$ref": "#/$defs/strings"},
        "change_risk_score": {"$ref": "#/$defs/nullableCount"},
        "change_risk_priority": {"type": ["string", "null"], "enum": ["high", "medium", "low", null]},
        "change_classification": {"$ref": "#/$defs/nullableString"},
        "mapped_test_files": {"$ref": "#/$defs/strings"},
        "test_selection_confidence": {"type": ["string", "null"], "enum": ["high", "medium", "low", null]},
        "structural_risk_ids": {"$ref": "#/$defs/strings"},
        "structural_risk_kinds": {"$ref": "#/$defs/strings"},
        "structural_recommendation": {"$ref": "#/$defs/nullableString"}
      }
