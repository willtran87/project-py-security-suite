{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:data-exposure:1.3",
  "title": "Python Security Suite data exposure synthesis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema_id", "authoritative", "purpose", "summary", "finding_assessments", "sink_surfaces", "sdk_observations", "standards", "limits", "limitations"],
  "properties": {
