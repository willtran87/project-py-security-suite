  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "nullableString": {"type": ["string", "null"]},
    "nullableBoolean": {"type": ["boolean", "null"]},
    "nullableNumber": {"type": ["number", "null"], "minimum": 0},
    "nullableCount": {"type": ["integer", "null"], "minimum": 0},
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "priority": {"enum": ["high", "medium", "low"]},
    "triageTier": {"enum": ["urgent", "elevated", "standard"]},
    "protection": {"enum": ["minimized-or-allowlisted", "redacted-or-masked", "configured-hook", "pseudonymized", "not-observed", "unknown"]},
    "crossReferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fusion_available", "fusion_review_tier", "corroboration", "review_reasons", "related_finding_ids", "related_tools", "changed_line", "line_covered", "coverage_percent", "diff_coverage_percent", "reachability_states", "runtime_observations", "graph_upstream_files", "graph_downstream_files", "graph_degree", "owners", "change_risk_score", "change_risk_priority", "change_classification", "mapped_test_files", "test_selection_confidence", "structural_risk_ids", "structural_risk_kinds", "structural_recommendation"],
