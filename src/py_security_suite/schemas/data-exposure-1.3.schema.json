      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "concern": {"type": "string", "minLength": 1},
        "sink_family": {"type": "string", "minLength": 1},
        "sink": {"$ref": "#/$defs/nullableString"},
        "sdk": {"$ref": "#/$defs/nullableString"},
        "path": {"type": "string", "minLength": 1},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "scope": {"enum": ["production", "test"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "structural_relevance": {"enum": ["runtime-observed", "disconnected-review", "changed-code", "statically-connected", "unknown"]},
        "sanitizer_visible": {"type": ["boolean", "null"]},
        "protection_status": {"$ref": "#/$defs/protection"},
        "data_classes": {"$ref": "#/$defs/strings"},
        "trust_boundary": {"type": "string", "minLength": 1},
        "risk_factors": {"$ref": "#/$defs/strings"},
        "review_priority": {"$ref": "#/$defs/priority"},
        "triage_tier": {"$ref": "#/$defs/triageTier"},
        "evidence_basis": {"const": "normalized-scanner-source-to-sink"},
        "classifications": {"$ref": "#/$defs/strings"},
        "source_tools": {"$ref": "#/$defs/strings"},
        "recommended_action": {"type": "string", "minLength": 1},
        "verification_steps": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string", "minLength": 1}},
        "evidence_artifacts": {"$ref": "#/$defs/strings"},
        "cross_references": {"$ref": "#/$defs/crossReferences"},
        "sdk_dependency_context": {"$ref": "#/$defs/sdkDependencyContext"}
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line", "scope", "sink_family", "sink", "label", "sdk", "sanitizer_visible", "protection_status", "data_classes", "trust_boundary", "risk_factors", "review_priority", "structural_context", "sdk_dependency_context", "verification_steps"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "scope": {"enum": ["production", "test"]},
        "sink_family": {"type": "string", "minLength": 1},
        "sink": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "sdk": {"$ref": "#/$defs/nullableString"},
        "sanitizer_visible": {"type": "boolean"},
        "protection_status": {"$ref": "#/$defs/protection"},
        "data_classes": {"$ref": "#/$defs/strings"},
        "trust_boundary": {"type": "string", "minLength": 1},
        "risk_factors": {"$ref": "#/$defs/strings"},
        "review_priority": {"$ref": "#/$defs/priority"},
        "structural_context": {"$ref": "#/$defs/surfaceContext"},
        "sdk_dependency_context": {"$ref": "#/$defs/sdkDependencyContext"},
        "verification_steps": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string", "minLength": 1}}
      }
    },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdk", "family", "module", "package", "evidence", "path", "line", "scope"],
      "properties": {
        "sdk": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "module": {"type": "string", "minLength": 1},
        "package": {"$ref": "#/$defs/nullableString"},
        "evidence": {"enum": ["import", "declared-dependency"]},
        "path": {"type": "string", "minLength": 1},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "scope": {"enum": ["production", "test", "repository"]}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "title", "uri"],
      "properties": {
        "identifier": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "format": "uri"}
      }
    }
  }
}
