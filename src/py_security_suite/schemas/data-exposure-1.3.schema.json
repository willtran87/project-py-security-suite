        "logging_findings": {"$ref": "#/$defs/count"},
        "telemetry_findings": {"$ref": "#/$defs/count"},
        "production_sink_surfaces": {"$ref": "#/$defs/count"},
        "test_sink_surfaces": {"$ref": "#/$defs/count"},
        "configuration_review_surfaces": {"$ref": "#/$defs/count"},
        "high_priority_review_surfaces": {"$ref": "#/$defs/count"},
        "sensitive_context_surfaces": {"$ref": "#/$defs/count"},
        "protected_surfaces": {"$ref": "#/$defs/count"},
        "fusion_enriched_findings": {"$ref": "#/$defs/count"},
        "urgent_cross_referenced_findings": {"$ref": "#/$defs/count"},
        "changed_exposure_findings": {"$ref": "#/$defs/count"},
        "uncovered_exposure_findings": {"$ref": "#/$defs/count"},
        "runtime_observed_exposure_findings": {"$ref": "#/$defs/count"},
        "broad_blast_radius_findings": {"$ref": "#/$defs/count"},
        "owned_exposure_findings": {"$ref": "#/$defs/count"},
        "exposure_findings_with_mapped_tests": {"$ref": "#/$defs/count"},
        "high_change_risk_exposure_findings": {"$ref": "#/$defs/count"},
        "exposure_findings_with_sdk_package_risk": {"$ref": "#/$defs/count"},
        "structurally_enriched_surfaces": {"$ref": "#/$defs/count"},
        "changed_sink_surfaces": {"$ref": "#/$defs/count"},
        "uncovered_sink_surfaces": {"$ref": "#/$defs/count"},
        "runtime_observed_sink_surfaces": {"$ref": "#/$defs/count"},
        "disconnected_sink_surfaces": {"$ref": "#/$defs/count"},
        "compound_sink_surfaces": {"$ref": "#/$defs/count"},
        "owned_sink_surfaces": {"$ref": "#/$defs/count"},
        "sink_surfaces_with_mapped_tests": {"$ref": "#/$defs/count"},
        "high_change_risk_sink_surfaces": {"$ref": "#/$defs/count"},
