      "properties": {
        "context_available": {"type": "boolean"},
        "changed_line": {"$ref": "#/$defs/nullableBoolean"},
        "line_covered": {"$ref": "#/$defs/nullableBoolean"},
        "coverage_percent": {"$ref": "#/$defs/nullableNumber"},
        "diff_coverage_percent": {"$ref": "#/$defs/nullableNumber"},
        "reachability_states": {"$ref": "#/$defs/strings"},
        "runtime_observations": {"$ref": "#/$defs/strings"},
        "graph_upstream_files": {"$ref": "#/$defs/nullableCount"},
        "graph_downstream_files": {"$ref": "#/$defs/nullableCount"},
        "graph_degree": {"$ref": "#/$defs/nullableCount"},
        "related_finding_ids": {"$ref": "#/$defs/strings"},
        "related_tools": {"$ref": "#/$defs/strings"},
        "owners": {"$ref": "#/$defs/strings"},
        "change_risk_score": {"$ref": "#/$defs/nullableCount"},
        "change_risk_priority": {"type": ["string", "null"], "enum": ["high", "medium", "low", null]},
        "change_classification": {"$ref": "#/$defs/nullableString"},
        "mapped_test_files": {"$ref": "#/$defs/strings"},
        "test_selection_confidence": {"type": ["string", "null"], "enum": ["high", "medium", "low", null]},
        "structural_risk_ids": {"$ref": "#/$defs/strings"},
        "structural_risk_kinds": {"$ref": "#/$defs/strings"},
        "structural_recommendation": {"$ref": "#/$defs/nullableString"}
      }
    },
    "sdkDependencyContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_available", "risk_present", "risk_tier", "packages", "packages_with_findings", "package_finding_ids", "package_finding_tools", "package_classifications", "distinct_advisory_count", "advisory_observation_count", "advisory_clusters", "advisories_with_import_evidence", "advisories_in_executable_imports", "advisories_flagged_unused", "highest_severity", "lineage", "risk_reasons", "citations"],
      "properties": {
        "context_available": {"type": "boolean"},
        "risk_present": {"type": "boolean"},
        "risk_tier": {"enum": ["high", "medium", "none"]},
        "packages": {"$ref": "#/$defs/strings"},
        "packages_with_findings": {"$ref": "#/$defs/strings"},
        "package_finding_ids": {"$ref": "#/$defs/strings"},
        "package_finding_tools": {"$ref": "#/$defs/strings"},
        "package_classifications": {"$ref": "#/$defs/strings"},
        "distinct_advisory_count": {"$ref": "#/$defs/count"},
        "advisory_observation_count": {"$ref": "#/$defs/count"},
        "advisory_clusters": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/sdkAdvisoryCluster"}},
        "advisories_with_import_evidence": {"$ref": "#/$defs/count"},
        "advisories_in_executable_imports": {"$ref": "#/$defs/count"},
        "advisories_flagged_unused": {"$ref": "#/$defs/count"},
        "highest_severity": {"type": ["string", "null"], "enum": ["critical", "high", "medium", "low", "informational", "unknown", null]},
        "lineage": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/sdkLineage"}},
