{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:benchmark-adapter-manifest:1.1",
  "title": "Registry-bound benchmark adapter execution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "benchmark_version", "adapter_version", "protocol", "adapter_contract", "corpus", "stages", "normalized_result", "thresholds", "evaluation", "authority_policy", "isolation", "attestations"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "benchmark_id": {"$ref": "#/$defs/id"},
    "benchmark_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "adapter_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "protocol": {"enum": ["classification", "temporal-calibration", "verification-competition", "test-generation", "fuzzing-statistical", "stochastic-adversarial", "assessor-agreement", "biometric-performance", "proficiency-testing", "conformance", "detection-evaluation"]},
    "adapter_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "sha256", "normalizer", "required_inputs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "sha256": {"$ref": "#/$defs/sha256"}, "normalizer": {"type": "string", "minLength": 1, "maxLength": 512},
        "required_inputs": {"type": "array", "minItems": 4, "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["name", "path", "sha256", "validation"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 256}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "validation": {"$ref": "#/$defs/inputValidation"}}}}
      }
    },
    "corpus": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "license_sha256", "label_authority_sha256", "organization_approved"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "license_sha256": {"$ref": "#/$defs/sha256"}, "label_authority_sha256": {"$ref": "#/$defs/sha256"}, "organization_approved": {"const": true}}},
    "stages": {"type": "array", "minItems": 1, "maxItems": 12, "contains": {"type": "object", "properties": {"name": {"const": "run"}}, "required": ["name"]}, "items": {"$ref": "#/$defs/stage"}},
    "normalized_result": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}}},
    "thresholds": {"type": "object", "minProperties": 1, "maxProperties": 8, "propertyNames": {"pattern": "^(minimum|maximum)_[a-z][a-z0-9_]{0,63}$"}, "additionalProperties": {"type": "number", "minimum": 0}},
    "evaluation": {"type": "object", "additionalProperties": false, "required": ["minimum_cases", "split_strategy", "positive_controls", "negative_controls", "acceptance_criteria_sha256", "independent_reviewers", "random_seeds", "required_strata", "power_analysis_sha256", "minimum_power", "confidence_level", "maximum_confidence_interval_width", "minimum_repetitions", "leakage_check_sha256", "duplicate_check_sha256", "holdout_sequestered"], "properties": {"minimum_cases": {"type": "integer", "minimum": 1, "maximum": 1000000}, "split_strategy": {"enum": ["official-fixed", "project-split", "time-split"]}, "positive_controls": {"type": "integer", "minimum": 1}, "negative_controls": {"type": "integer", "minimum": 1}, "acceptance_criteria_sha256": {"$ref": "#/$defs/sha256"}, "independent_reviewers": {"type": "integer", "minimum": 0}, "random_seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}, "required_strata": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}, "power_analysis_sha256": {"$ref": "#/$defs/sha256"}, "minimum_power": {"type": "number", "minimum": 0.8, "maximum": 1}, "confidence_level": {"type": "number", "minimum": 0.9, "maximum": 0.999}, "maximum_confidence_interval_width": {"type": "number", "minimum": 0.001, "maximum": 0.5}, "minimum_repetitions": {"type": "integer", "minimum": 3, "maximum": 1000}, "leakage_check_sha256": {"$ref": "#/$defs/sha256"}, "duplicate_check_sha256": {"$ref": "#/$defs/sha256"}, "holdout_sequestered": {"const": true}}},
    "authority_policy": {"type": "object", "additionalProperties": false, "required": ["minimum_distinct_signers", "minimum_distinct_organizations", "key_separation_groups", "organization_separation_groups"], "properties": {"minimum_distinct_signers": {"type": "integer", "minimum": 4, "maximum": 32}, "minimum_distinct_organizations": {"type": "integer", "minimum": 2, "maximum": 32}, "key_separation_groups": {"$ref": "#/$defs/separationGroups"}, "organization_separation_groups": {"$ref": "#/$defs/separationGroups"}}},
    "isolation": {"$ref": "#/$defs/isolation"},
    "attestations": {"type": "object", "additionalProperties": false, "required": ["trusted_time", "replay_protection", "contamination_manifest", "runner_sbom", "runner_provenance", "environment", "acceptance_criteria", "adapter_conformance", "runtime_observation"], "properties": {"trusted_time": {"$ref": "#/$defs/attestation"}, "replay_protection": {"$ref": "#/$defs/attestation"}, "contamination_manifest": {"$ref": "#/$defs/attestation"}, "runner_sbom": {"$ref": "#/$defs/attestation"}, "runner_provenance": {"$ref": "#/$defs/attestation"}, "environment": {"$ref": "#/$defs/attestation"}, "acceptance_criteria": {"$ref": "#/$defs/attestation"}, "adapter_conformance": {"$ref": "#/$defs/attestation"}, "runtime_observation": {"$ref": "#/$defs/attestation"}, "external_isolation": {"$ref": "#/$defs/attestation"}, "cleanup_capability": {"$ref": "#/$defs/attestation"}}}
  },
  "allOf": [
    {"properties": {"evaluation": {"properties": {"confidence_level": {"const": 0.95}}}}},
    {"if": {"properties": {"protocol": {"enum": ["classification", "detection-evaluation"]}}}, "then": {"properties": {"thresholds": {"$ref": "#/$defs/classificationThresholds"}, "evaluation": {"properties": {"minimum_cases": {"minimum": 20}}}}}},
    {"if": {"properties": {"protocol": {"enum": ["verification-competition", "test-generation"]}}}, "then": {"properties": {"thresholds": {"$ref": "#/$defs/accuracyThresholds"}, "evaluation": {"properties": {"minimum_cases": {"minimum": 20}}}}}},
    {"if": {"properties": {"protocol": {"const": "conformance"}}}, "then": {"properties": {"thresholds": {"$ref": "#/$defs/conformanceThresholds"}, "evaluation": {"properties": {"minimum_cases": {"minimum": 10}}}}}},
    {"if": {"properties": {"protocol": {"const": "temporal-calibration"}}}, "then": {"properties": {"thresholds": {"$ref": "#/$defs/temporalThresholds"}, "evaluation": {"properties": {"minimum_cases": {"minimum": 100}}}}}},
    {"if": {"properties": {"protocol": {"const": "stochastic-adversarial"}}}, "then": {"properties": {"thresholds": {"$ref": "#/$defs/stochasticThresholds"}, "evaluation": {"properties": {"minimum_cases": {"minimum": 30}, "random_seeds": {"minItems": 5}, "minimum_repetitions": {"minimum": 5}}}}}},
    {"if": {"properties": {"protocol": {"const": "assessor-agreement"}}}, "then": {"properties": {"thresholds": {"$ref": "#/$defs/agreementThresholds"}, "evaluation": {"properties": {"minimum_cases": {"minimum": 20}, "independent_reviewers": {"minimum": 2}}}}}},
    {"if": {"properties": {"protocol": {"const": "biometric-performance"}}}, "then": {"properties": {"thresholds": {"$ref": "#/$defs/biometricThresholds"}, "evaluation": {"properties": {"minimum_cases": {"minimum": 300}}}}}},
    {"if": {"properties": {"protocol": {"const": "proficiency-testing"}}}, "then": {"properties": {"thresholds": {"$ref": "#/$defs/proficiencyThresholds"}, "evaluation": {"properties": {"minimum_cases": {"minimum": 10}}}}}},
    {"if": {"properties": {"protocol": {"const": "fuzzing-statistical"}}}, "then": {"properties": {"thresholds": {"$ref": "#/$defs/fuzzingThresholds"}, "evaluation": {"properties": {"minimum_cases": {"minimum": 10}}}}}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "classificationThresholds": {"type": "object", "additionalProperties": false, "required": ["minimum_precision", "minimum_recall", "minimum_f1", "maximum_false_positive_rate"], "properties": {"minimum_precision": {"$ref": "#/$defs/ratio"}, "minimum_recall": {"$ref": "#/$defs/ratio"}, "minimum_f1": {"$ref": "#/$defs/ratio"}, "maximum_false_positive_rate": {"$ref": "#/$defs/ratio"}}},
    "accuracyThresholds": {"type": "object", "additionalProperties": false, "required": ["minimum_accuracy"], "properties": {"minimum_accuracy": {"$ref": "#/$defs/ratio"}}},
    "conformanceThresholds": {"type": "object", "additionalProperties": false, "required": ["minimum_outcome_accuracy", "minimum_conformance_rate"], "properties": {"minimum_outcome_accuracy": {"$ref": "#/$defs/ratio"}, "minimum_conformance_rate": {"$ref": "#/$defs/ratio"}}},
    "temporalThresholds": {"type": "object", "additionalProperties": false, "required": ["maximum_brier_score"], "properties": {"maximum_brier_score": {"$ref": "#/$defs/ratio"}}},
    "stochasticThresholds": {"type": "object", "additionalProperties": false, "required": ["maximum_attack_success_rate", "minimum_mean_utility"], "properties": {"maximum_attack_success_rate": {"$ref": "#/$defs/ratio"}, "minimum_mean_utility": {"$ref": "#/$defs/ratio"}}},
    "agreementThresholds": {"type": "object", "additionalProperties": false, "required": ["minimum_agreement", "minimum_chance_corrected_agreement"], "properties": {"minimum_agreement": {"$ref": "#/$defs/ratio"}, "minimum_chance_corrected_agreement": {"$ref": "#/$defs/ratio"}}},
    "biometricThresholds": {"type": "object", "additionalProperties": false, "required": ["maximum_fmr_wilson_upper_95", "maximum_fnmr_wilson_upper_95", "maximum_iapar_wilson_upper_95", "maximum_worst_group_fmr_wilson_upper_95", "maximum_worst_group_fnmr_wilson_upper_95"], "properties": {"maximum_fmr_wilson_upper_95": {"$ref": "#/$defs/ratio"}, "maximum_fnmr_wilson_upper_95": {"$ref": "#/$defs/ratio"}, "maximum_iapar_wilson_upper_95": {"$ref": "#/$defs/ratio"}, "maximum_worst_group_fmr_wilson_upper_95": {"$ref": "#/$defs/ratio"}, "maximum_worst_group_fnmr_wilson_upper_95": {"$ref": "#/$defs/ratio"}}},
    "proficiencyThresholds": {"type": "object", "additionalProperties": false, "required": ["minimum_agreement", "minimum_chance_corrected_agreement", "minimum_reference_accuracy"], "properties": {"minimum_agreement": {"$ref": "#/$defs/ratio"}, "minimum_chance_corrected_agreement": {"$ref": "#/$defs/ratio"}, "minimum_reference_accuracy": {"$ref": "#/$defs/ratio"}}},
    "fuzzingThresholds": {"type": "object", "additionalProperties": false, "required": ["minimum_executions", "minimum_coverage_gain"], "properties": {"minimum_executions": {"type": "number", "minimum": 0}, "minimum_coverage_gain": {"$ref": "#/$defs/ratio"}}},
    "ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "inputValidation": {"type": "object", "required": ["format", "size_bytes", "entries", "validated"], "properties": {"format": {"enum": ["opaque", "json", "zip", "tar"]}, "size_bytes": {"type": "integer", "minimum": 1}, "entries": {"type": "integer", "minimum": 1}, "expanded_bytes": {"type": "integer", "minimum": 1}, "validated": {"const": true}}, "allOf": [{"if": {"properties": {"format": {"enum": ["zip", "tar"]}}}, "then": {"required": ["expanded_bytes"]}, "else": {"not": {"required": ["expanded_bytes"]}}}], "additionalProperties": false},
    "separationGroups": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["trusted_time", "replay_protection", "contamination_manifest", "runner_sbom", "runner_provenance", "environment", "acceptance_criteria", "adapter_conformance", "runtime_observation", "external_isolation", "cleanup_capability"]}}},
    "attestation": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "media_type", "public_key_path", "public_key_sha256", "signature_path"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "media_type": {"const": "application/vnd.pysec.attestation+json;version=1.1"}, "public_key_path": {"type": "string", "minLength": 1}, "public_key_sha256": {"$ref": "#/$defs/sha256"}, "signature_path": {"type": "string", "minLength": 1}}},
    "stage": {"type": "object", "additionalProperties": false, "required": ["name", "executable", "executable_sha256", "arguments", "environment", "timeout_seconds", "expected_exit_codes"], "properties": {"name": {"enum": ["prepare", "build", "run", "normalize", "verify", "cleanup"]}, "executable": {"type": "string", "minLength": 1}, "executable_sha256": {"$ref": "#/$defs/sha256"}, "arguments": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 8192}}, "environment": {"type": "object", "maxProperties": 64, "propertyNames": {"pattern": "^[A-Z][A-Z0-9_]{0,63}$"}, "additionalProperties": {"type": "string", "maxLength": 8192}}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}, "expected_exit_codes": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 255}}}},
    "isolation": {"type": "object", "additionalProperties": false, "required": ["mode", "network_policy", "disposable_target", "external_receipt_sha256", "oci"], "properties": {"mode": {"enum": ["process", "external-sandbox", "oci"]}, "network_policy": {"enum": ["deny", "authorized-target-only", "inherited"]}, "disposable_target": {"type": "boolean"}, "external_receipt_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "oci": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/oci"}]}}},
    "oci": {"type": "object", "additionalProperties": false, "required": ["runtime", "runtime_sha256", "runtime_name", "runtime_version", "runtime_capabilities_sha256", "runtime_trust_sha256", "image", "memory_bytes", "cpu_count", "pids_limit", "seccomp_profile", "seccomp_profile_sha256", "apparmor_profile", "maximum_output_bytes", "maximum_output_files"], "properties": {"runtime": {"type": "string", "minLength": 1}, "runtime_sha256": {"$ref": "#/$defs/sha256"}, "runtime_name": {"enum": ["docker", "podman", "nerdctl"]}, "runtime_version": {"type": "string", "minLength": 1, "maxLength": 128}, "runtime_capabilities_sha256": {"$ref": "#/$defs/sha256"}, "runtime_trust_sha256": {"$ref": "#/$defs/sha256"}, "image": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"}, "memory_bytes": {"type": "integer", "minimum": 67108864}, "cpu_count": {"type": "number", "minimum": 0.1, "maximum": 256}, "pids_limit": {"type": "integer", "minimum": 16, "maximum": 65536}, "seccomp_profile": {"type": ["string", "null"]}, "seccomp_profile_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "apparmor_profile": {"type": ["string", "null"]}, "maximum_output_bytes": {"type": "integer", "minimum": 1048576, "maximum": 17179869184}, "maximum_output_files": {"type": "integer", "minimum": 1, "maximum": 100000}}}
  }
}
