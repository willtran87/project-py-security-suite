{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:operational-trend:1.2",
  "title": "Operational trend with validation debt and owner continuity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authoritative", "scope", "summary", "delta", "comparison", "validation_owner_history", "scanner_history", "anomalies", "timeline"],
  "properties": {
    "schema_version": {"const": "1.2"},
    "authoritative": {"const": false},
    "scope": {"type": "string", "minLength": 1},
    "summary": {"type": "object"},
    "delta": {"type": "object", "additionalProperties": {"type": "integer"}},
    "comparison": {"type": "object"},
    "validation_owner_history": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "observations", "first_subjects", "latest_subjects", "delta"],
        "properties": {
          "owner": {"type": "string", "minLength": 1, "maxLength": 256},
          "observations": {
            "type": "array",
            "minItems": 2,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["scan_id", "evidence_available", "subjects"],
              "properties": {
                "scan_id": {"type": "string", "minLength": 1},
                "evidence_available": {"type": "boolean"},
                "subjects": {"type": "integer", "minimum": 0}
              }
            }
          },
          "first_subjects": {"type": "integer", "minimum": 0},
          "latest_subjects": {"type": "integer", "minimum": 0},
          "delta": {"type": "integer"}
        }
      }
    },
    "scanner_history": {"type": "array", "items": {"type": "object"}},
    "anomalies": {"type": "array", "items": {"type": "object"}},
    "timeline": {"type": "array", "minItems": 2, "maxItems": 100, "items": {"type": "object"}}
  }
}
