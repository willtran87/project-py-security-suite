{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:benchmark-contamination-analysis:1.1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "algorithm", "training_artifact_sha256", "benchmark_artifact_sha256", "overlap_count", "canonicalization", "training_semantic_sha256", "benchmark_semantic_sha256", "semantic_overlap_count"],
  "properties": {
    "schema_version": {"const": "1.1"}, "algorithm": {"const": "sha256-set-intersection"}, "training_artifact_sha256": {"$ref": "#/$defs/digests"}, "benchmark_artifact_sha256": {"$ref": "#/$defs/digests"}, "overlap_count": {"const": 0},
    "canonicalization": {"const": "ast-token-shape-v1"}, "training_semantic_sha256": {"$ref": "#/$defs/digests"}, "benchmark_semantic_sha256": {"$ref": "#/$defs/digests"}, "semantic_overlap_count": {"const": 0}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "digests": {"type": "array", "minItems": 1, "maxItems": 10000000, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}}
}
