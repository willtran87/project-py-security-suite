{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:standards-source-manifest:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "allowed_hosts", "sources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "allowed_hosts": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"}},
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "baseline_version", "publisher", "url", "baseline_sha256", "maximum_bytes", "baseline_path", "media_type", "impact"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,127}$"},
          "baseline_version": {"type": "string", "minLength": 1, "maxLength": 256},
          "publisher": {"type": "string", "minLength": 1, "maxLength": 256},
          "url": {"type": "string", "pattern": "^https://", "maxLength": 4096},
          "baseline_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "maximum_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
          "baseline_path": {"type": "string", "minLength": 1},
          "media_type": {"enum": ["text/plain", "text/html", "application/json", "application/xml", "text/xml", "application/pdf"]},
          "impact": {
            "type": "object", "additionalProperties": false,
            "required": ["profiles", "controls", "benchmarks"],
            "properties": {
              "profiles": {"$ref": "#/$defs/identifiers"},
              "controls": {"$ref": "#/$defs/identifiers"},
              "benchmarks": {"$ref": "#/$defs/identifiers"}
            }
          }
        }
      }
    }
  },
  "$defs": {"identifiers": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}}
}
