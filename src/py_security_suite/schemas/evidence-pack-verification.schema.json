{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:evidence-pack-verification:1.0",
  "title": "Project Python Security Suite evidence pack verification receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verified",
    "authoritative",
    "admission",
    "pack",
    "report",
    "audit_package",
    "required_authorities"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "verified": { "const": true },
    "authoritative": { "const": false },
    "admission": { "const": "requires_external_approval" },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "files_verified"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" },
        "files_verified": { "type": "integer", "minimum": 1 }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scan_id", "checksums_sha256", "outcome"],
      "properties": {
        "scan_id": { "type": "string", "minLength": 1 },
        "checksums_sha256": { "$ref": "#/$defs/digest" },
        "outcome": { "enum": ["pass", "warn", "fail", "incomplete"] }
      }
    },
    "audit_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "files_verified"],
      "properties": {
        "sha256": { "$ref": "#/$defs/digest" },
        "files_verified": { "type": "integer", "minimum": 1 }
      }
    },
    "required_authorities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
