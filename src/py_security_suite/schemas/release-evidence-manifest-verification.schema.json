{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:release-evidence-manifest-verification:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verified", "authoritative", "admission", "scope", "manifest", "report", "evidence", "required_authorities"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "verified": {"const": true},
    "authoritative": {"const": false},
    "admission": {"const": "requires_external_approval"},
    "scope": {"type": "string", "minLength": 1},
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "manifest_id"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"},
        "manifest_id": {"$ref": "#/$defs/digest"}
      }
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "required": ["scan_id", "checksums_sha256", "outcome"],
      "properties": {
        "scan_id": {"type": "string", "minLength": 1},
        "checksums_sha256": {"$ref": "#/$defs/digest"},
        "outcome": {"enum": ["pass", "warn", "fail", "incomplete"]}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["verified_count", "verified_names", "required_names", "missing_required"],
      "properties": {
        "verified_count": {"type": "integer", "minimum": 1, "maximum": 100},
        "verified_names": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_names": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "missing_required": {"type": "array", "maxItems": 0}
      }
    },
    "required_authorities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["controlled-signing", "organization-security", "release-approver"]}}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
