{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:project-py-security-suite:schema:report-security:1.0","type":"object","additionalProperties":false,"required":["schema_version","classification","access_policy","permission_postcondition","access_control_verification","retention_days","delete_after","retention_enforcement","retention_time_authority","encryption_support","key_custody","key_lifecycle_enforcement","plaintext_disposal"],"properties":{"schema_version":{"const":"1.0"},"classification":{"enum":["confidential","restricted"]},"access_policy":{"const":"owner-only"},"permission_postcondition":{"const":"verified-before-atomic-publication"},"access_control_verification":{"enum":["exact-current-user-sid","mode-0700-0600"]},"retention_days":{"type":"integer","minimum":1,"maximum":3650},"delete_after":{"type":"string","format":"date-time"},"retention_enforcement":{"const":"verified-expiry-atomic-purge"},"retention_time_authority":{"const":"rfc3161-deployment-pinned-timestamp"},"encryption_support":{"const":"X25519-HKDF-SHA256+A256GCM authenticated archive"},"key_custody":{"const":"external-recipient-private-key"},"key_lifecycle_enforcement":{"const":"signed-provider-receipt-and-cryptographic-erasure"},"plaintext_disposal":{"const":"optional-post-encryption-verified-purge"}}}
