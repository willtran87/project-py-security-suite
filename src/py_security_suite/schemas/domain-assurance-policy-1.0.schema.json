        "strings": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
            }
        },
        "artifacts": {
            "type": "array",
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,199}\\.json$"
            }
        },
        "requirement": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "kind",
                "objective",
                "subjects",
                "evidence_artifacts",
                "test_ids",
                "enforcement_points"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                },
                "kind": {
                    "$ref": "#/$defs/requirementKind"
                },
                "objective": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                },
                "subjects": {
                    "$ref": "#/$defs/strings"
                },
                "evidence_artifacts": {
                    "$ref": "#/$defs/artifacts"
                },
                "test_ids": {
                    "$ref": "#/$defs/strings"
                },
                "enforcement_points": {
                    "$ref": "#/$defs/strings"
                }
            }
        },
        "domain": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "applicable",
                "owner",
                "requirements"
            ],
            "properties": {
                "name": {
                    "$ref": "#/$defs/domainName"
                },
                "applicable": {
                    "type": "boolean"
                },
                "owner": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                },
                "requirements": {
                    "type": "array",
                    "maxItems": 2000,
                    "items": {
                        "$ref": "#/$defs/requirement"
                    }
                }
            }
        }
    }
}
