{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:project-py-security-suite:schema:domain-assurance-policy:1.0",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "enforce_inferred_domains",
        "domains"
    ],
    "properties": {
        "schema_version": {
            "const": "1.0"
        },
        "enforce_inferred_domains": {
            "type": "boolean"
        },
        "domains": {
            "type": "array",
            "maxItems": 33,
            "uniqueItems": true,
            "items": {
                "$ref": "#/$defs/domain"
            }
        }
    },
    "$defs": {
        "domainName": {
            "enum": [
                "business-logic",
                "privacy-lifecycle",
                "resilience",
                "detection-engineering",
