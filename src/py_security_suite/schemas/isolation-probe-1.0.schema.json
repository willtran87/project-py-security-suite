{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-py-security-suite:schema:isolation-probe:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis", "required", "executed", "complete", "capabilities", "policy_observations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "analysis": {"const": "active-isolation-capability-canaries"},
    "required": {"type": "boolean"},
    "executed": {"type": "boolean"},
    "complete": {"type": "boolean"},
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "network-tcp4-denied": {"type": "boolean"},
        "network-udp4-denied": {"type": "boolean"},
        "network-tcp6-denied": {"type": "boolean"},
        "network-host-tcp4-denied": {"type": "boolean"},
        "network-host-udp4-denied": {"type": "boolean"},
        "network-udp6-denied": {"type": "boolean"},
        "network-unix-socket-denied": {"type": "boolean"},
        "network-raw-socket-denied": {"type": "boolean"},
        "proxy-environment-cleared": {"type": "boolean"},
        "network-host-interface-tested": {"type": "boolean"},
        "network-unix-socket-tested": {"type": "boolean"},
        "target-root-read-only": {"type": "boolean"},
        "target-nested-read-only": {"type": "boolean"},
        "target-link-creation-denied": {"type": "boolean"},
        "private-scratch-writable": {"type": "boolean"},
        "host-filesystem-read-denied": {"type": "boolean"},
        "credential-environment-cleared": {"type": "boolean"},
        "parent-process-access-denied": {"type": "boolean"},
        "process-namespace-isolated": {"type": "boolean"},
        "device-namespace-isolated": {"type": "boolean"},
        "host-ipc-denied": {"type": "boolean"},
        "bounded-output-pipes": {"type": "boolean"},
        "bounded-private-scratch": {"type": "boolean"},
        "linux-no-new-privileges": {"type": "boolean"},
        "linux-capabilities-dropped": {"type": "boolean"},
        "linux-seccomp-filter-enforced": {"type": "boolean"},
        "linux-seccomp-policy-bound": {"type": "boolean"},
        "macos-sandbox-profile-bound": {"type": "boolean"},
        "effective-kernel-policy-attested": {"type": "boolean"},
        "windows-dep-enabled": {"type": "boolean"},
        "windows-aslr-enabled": {"type": "boolean"},
        "windows-dynamic-code-prohibited": {"type": "boolean"},
        "windows-child-processes-prohibited": {"type": "boolean"}
      }
    },
    "policy_observations": {"type": "object", "additionalProperties": false, "properties": {"platform": {"type": "string"}, "process_id": {"type": "integer", "minimum": 1}, "kernel_identity_sha256": {"$ref": "#/$defs/digest"}, "policy_introspection_available": {"type": "boolean"}, "no_new_privileges": {"type": "boolean"}, "capabilities_dropped": {"type": "boolean"}, "seccomp_mode": {"type": "integer", "minimum": 0, "maximum": 2}, "seccomp_active": {"type": "boolean"}, "seccomp_filters": {"type": "integer", "minimum": 0}, "seccomp_policy_sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"}, "sandbox_profile_sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"}, "effective_policy_attestation_sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"}, "effective_policy_attestation": {"type": ["object", "null"]}, "effective_policy_authority_receipt": {"type": ["object", "null"]}, "dep_enabled": {"type": "boolean"}, "aslr_enabled": {"type": "boolean"}, "dynamic_code_prohibited": {"type": "boolean"}, "child_processes_prohibited": {"type": "boolean"}}},
    "exit_code": {"type": ["integer", "null"]},
    "timed_out": {"type": "boolean"},
    "output_limit_exceeded": {"type": "boolean"},
    "scratch_limit_exceeded": {"type": "boolean"},
    "resident_memory_limit_exceeded": {"type": "boolean"},
    "resource_limits_enforced": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "resource_limit_errors": {"type": "array", "items": {"type": "string"}},
    "probe_sha256": {"$ref": "#/$defs/digest"},
    "interpreter_sha256": {"$ref": "#/$defs/digest"},
    "sandbox_executable_sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "result_sha256": {"$ref": "#/$defs/digest"},
    "error": {"type": ["string", "null"]}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
