{
  "schema_version": "1.0",
  "workflow": ".github/workflows/ci.yml",
  "required_gate": "required-gate",
  "required_jobs": [
    "oci-containment-integration",
    "containment-integration",
    "companion-service-integration",
    "companion-browser-integration",
    "test",
    "test-assurance",
    "quality",
    "dependency-audit"
  ],
  "required_matrices": {
    "oci-containment-integration": {
      "runtime": ["docker", "podman-rootless"]
    },
    "containment-integration": {
      "os": ["ubuntu-latest", "windows-latest", "macos-latest"]
    }
  },
  "required_test_matrices": {
    "companion-browser-integration": {
      "path": "tests/integration/test_browser_live.py",
      "test": "test_real_browser_security_matrix",
      "junit_output": ".artifacts/live-assurance/browser-junit.xml",
      "parameters": {
        "browser_engine": ["chromium", "firefox", "webkit"],
        "role": ["anonymous", "tenant-a", "tenant-b"]
      }
    }
  }
}
