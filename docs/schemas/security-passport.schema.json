{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-py-security-suite.example/schemas/security-passport.schema.json",
  "title": "Python Security Suite Security Passport",
  "type": "object",
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": {"const": "https://in-toto.io/Statement/v1"},
    "subject": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1001,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["name", "digest"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 4096},
          "digest": {
            "type": "object",
            "required": ["sha256"],
            "additionalProperties": false,
            "properties": {
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "predicateType": {"const": "https://slsa.dev/verification_summary/v1"},
    "predicate": {
      "type": "object",
      "required": ["verifier", "policy", "verificationResult", "verifiedLevels", "pysec"],
      "properties": {
        "verificationResult": {"enum": ["PASSED", "FAILED"]},
        "pysec": {"type": "object", "required": ["schema_version", "outcome", "profile"]}
      }
    }
  }
}
