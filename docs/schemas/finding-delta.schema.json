{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-py-security-suite.example/schemas/finding-delta.schema.json",
  "title": "Python Security Suite Finding Delta",
  "type": "object",
  "required": ["schema_version", "configured"],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "configured": {"type": "boolean"},
    "baseline": {"type": "object"},
    "counts": {"type": "object"},
    "match_strategies": {"type": "object"},
    "resolved": {"type": "array", "items": {"type": "object"}},
    "ownership_rules": {"type": "integer", "minimum": 0},
    "ownership_rule_details": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern", "owners"],
        "properties": {
          "pattern": {"type": "string", "minLength": 1},
          "owners": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
