include CHANGELOG.md
include CONTRIBUTING.md
include LICENSE
include MANIFEST.in
include README.md
include SECURITY.md
include pyproject.toml
include pysec.example.toml
include tach.toml
include tox.toml
include uv.lock
recursive-include companion *.py pyproject.toml uv.lock
prune companion/.venv
recursive-include containers *.lock *.toml Dockerfile
recursive-include docs *.json *.md
recursive-include examples *.json *.yaml *.yml
recursive-include scripts *.ps1
recursive-include scripts *.py
recursive-include security *.json *.toml
recursive-include src/py_security_suite py.typed
recursive-include src/py_security_suite/rules *.ini *.json *.psd1 *.toml *.txt *.yaml *.yml
recursive-include src/py_security_suite/schemas *.json
# The test suite depends on repository-only fixtures, workflows and model
# metadata, so it is deliberately not shipped in the sdist. Run tests from a
# repository checkout instead.
prune tests
global-exclude __pycache__ *.py[cod]
